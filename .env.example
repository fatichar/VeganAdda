# Copy to .env on the VPS; never commit passwords or Admin credentials.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Public Firebase web configuration for VeganAdda.
FIREBASE_PROJECT_ID=veganadda-app
FIREBASE_API_KEY=AIzaSyAZFHcYpXXOIadVwaQKN-3NV1ERD9KSWrM
FIREBASE_AUTH_DOMAIN=veganadda-app.firebaseapp.com
