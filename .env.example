# Copy to .env on the VPS; never commit passwords or Admin credentials.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Public Firebase web configuration for VeganAdda.
FIREBASE_PROJECT_ID=veganadda-app
FIREBASE_API_KEY=AIzaSyAZFHcYpXXOIadVwaQKN-3NV1ERD9KSWrM
FIREBASE_AUTH_DOMAIN=veganadda-app.firebaseapp.com
FIREBASE_APP_ID=1:1042536751762:web:ecf34b0e818ea0f04afc4b
# Firebase Console > Project settings > Cloud Messaging. Both are public client values.
FIREBASE_MESSAGING_SENDER_ID=1042536751762
FIREBASE_WEB_PUSH_VAPID_KEY=
FIREBASE_ADMIN_CREDENTIALS=/secure/path/to/firebase-admin-service-account.json
ADMIN_FIREBASE_UID=
# Local builds use this default. CI supplies an immutable GHCR digest at rollout.
IMAGE_REF=veganadda:local
APP_PORT=5080
APP_STANDBY_PORT=5081
# Verify a free subnet and the actual proxy source address before use.
DOCKER_SUBNET=172.30.87.0/24
TRUSTED_PROXY_IP=172.30.87.1
# Public, runtime analytics settings. Use VeganAdda's own property, not Greenfit's ID.
UMAMI_SCRIPT_URL=https://analytics.greenfit.in/script.js
UMAMI_WEBSITE_ID=29d3948e-23fe-4394-b433-799a76a4b09d
# Optional external operational logs. Token is secret; never put it in GitHub variables.
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_ENDPOINT=
