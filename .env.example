# Copy to .env on the VPS; never commit real values.
POSTGRES_PASSWORD=replace-with-a-long-random-password
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
ADMIN_GOOGLE_SUBJECT=
# Local builds use this default. CI supplies an immutable GHCR digest at rollout.
IMAGE_REF=veganadda:local
APP_PORT=5080
# Verify a free subnet and the actual proxy source address before use.
DOCKER_SUBNET=172.30.87.0/24
TRUSTED_PROXY_IP=172.30.87.1
