<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <meta name="theme-color" content="#012d1d" />
    <meta name="description" content="Find your vegan people. An India-first community for friendship, shared interests, networking and activism." />
    <link rel="icon" href="@Assets["favicon.ico"]" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <link rel="icon" type="image/png" sizes="32x32" href="@Assets["favicon.png"]" />
    <link rel="icon" type="image/png" sizes="16x16" href="@Assets["favicon-16.png"]" />
    <link rel="apple-touch-icon" href="@Assets["apple-touch-icon.png"]" />
    <link rel="manifest" href="@Assets["site.webmanifest"]" />
    <link rel="stylesheet" href="@Assets["_content/VeganAdda.UI/app.css"]" />
    <link rel="stylesheet" href="@Assets["VeganAdda.Web.styles.css"]" />
    <ImportMap AdditionalAttributes="ImportMapAttributes" />
    <HeadOutlet @rendermode="InteractiveWebAssembly" />
</head>

<body>
    <Routes @rendermode="InteractiveWebAssembly" />
    <script src="@Assets["_content/VeganAdda.UI/realtime.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    @if (!string.IsNullOrEmpty(Analytics.WebsiteId))
    {
        <script src="@Assets["js/analytics.js"]" defer></script>
        <script src="@Analytics.ScriptUrl" data-website-id="@Analytics.WebsiteId"
                data-domains="veganadda.com,www.veganadda.com" data-exclude-search="true"
                data-exclude-hash="true" data-do-not-track="true"
                data-before-send="veganAddaAnalyticsBeforeSend" defer></script>
    }
</body>

</html>

@code {
    [Microsoft.AspNetCore.Components.Inject]
    private VeganAdda.Web.Observability.AnalyticsSettings Analytics { get; set; } = default!;
    [Microsoft.AspNetCore.Components.Inject]
    private Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor { get; set; } = default!;

    private IReadOnlyDictionary<string, object> ImportMapAttributes => new Dictionary<string, object>
    {
        ["nonce"] = HttpContextAccessor.HttpContext?.Items["VeganAdda.CspNonce"]?.ToString() ?? string.Empty
    };
}
