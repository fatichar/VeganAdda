@inherits LayoutComponentBase
@implements IDisposable
@inject ICommunityApi Api
@inject IPlatform Platform
@inject NavigationManager Nav
<a href="#main" class="skip-link">Skip to content</a>
@if (!RendererInfo.IsInteractive) { <div class="hydration-notice" role="status">Loading…</div> }
<header class="site-header"><div class="header-inner"><a class="brand" href="/"><img class="brand-logo brand-logo-wide" src="_content/VeganAdda.UI/images/brand/logo.svg" width="312" height="92" alt="VeganAdda" /><img class="brand-logo brand-logo-compact" src="_content/VeganAdda.UI/images/brand/logo-mobile.svg" width="1346" height="210" alt="VeganAdda" /></a>
<nav class="desktop-nav" aria-label="Main navigation"><NavLink href="/" Match="NavLinkMatch.All">Discover</NavLink><NavLink href="/events">Events</NavLink><NavLink href="/messages" class="messages-link">Messages @if (unreadMessages > 0) { <span class="count" aria-label="@($"{unreadMessages} unread messages")">@unreadMessages</span> }</NavLink>@if (session?.IsAdmin == true) { <NavLink href="/admin">Admin</NavLink> }</nav>
<div class="header-actions"><a class="icon-button" href="/saved" aria-label="Saved items"><Icon Name="bookmark_border" /></a><a class="icon-button notification-link" href="/notifications" aria-label="Notifications"><Icon Name="notifications" />@if (unread > 0) { <span class="count">@unread</span> }</a><a aria-label="@(session?.Id == null ? "Sign in" : "Your profile and settings")" class="@(session?.Id == null ? "button sign-in" : "profile-link")" href="@(session?.Id == null ? "/signin" : "/settings")">@if (session?.Id != null) { <Avatar Name="@session.Name" Size="tiny" /> } else { <span>Sign in</span><Icon Name="arrow_forward" /> }</a></div></div></header>
@if (session?.Development == true) { <div class="dev-banner">Development · fictional profiles &amp; events <a href="/signin">Switch account</a></div> }
<main id="main" class="page" tabindex="-1">@if (session?.Id != null && new Uri(Nav.Uri).AbsolutePath.StartsWith("/messages")) { <ChatPushSettings /> }<ErrorBoundary @ref="boundary"><ChildContent>@Body</ChildContent><ErrorContent><Empty Title="Let's try that again" Text="This screen couldn't be loaded."><a class="button" href="/" data-enhance-nav="false">Return to discovery</a></Empty></ErrorContent></ErrorBoundary></main>
<footer class="site-footer"><a class="brand" href="/">VeganAdda</a><nav aria-label="Footer"><a href="/help">Community & help</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a>@if (session?.IsModerator == true && session?.IsAdmin != true) { <a href="/moderation">Profile review</a> }</nav><small>© @DateTime.UtcNow.Year VeganAdda</small></footer>
<nav class="bottom-nav" aria-label="Mobile navigation"><NavLink href="/" Match="NavLinkMatch.All"><Icon Name="explore" /><span>Discover</span></NavLink><NavLink href="/events"><Icon Name="festival" /><span>Events</span></NavLink><NavLink href="/messages" class="messages-link"><Icon Name="chat_bubble" /><span>Messages</span>@if (unreadMessages > 0) { <span class="count" aria-label="@($"{unreadMessages} unread messages")">@unreadMessages</span> }</NavLink>@if (session?.IsAdmin == true) { <NavLink href="/admin"><Icon Name="admin_panel_settings" /><span>Admin</span></NavLink> }</nav>
<div id="blazor-error-ui">Connection interrupted. <a href="" class="reload">Reload this page</a></div>
@code {
    Session? session; int unread, unreadMessages; ErrorBoundary? boundary; CancellationTokenSource stop = new();
    protected override async Task OnInitializedAsync() { try { session = await Api.Get<Session>("session"); await Refresh(); } catch { } Platform.Changed += Changed; Nav.LocationChanged += Location; }
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (firstRender) { await Platform.StartRealtime(); _ = Poll(); } }
    async Task Poll() { try { using var timer = new PeriodicTimer(TimeSpan.FromMinutes(2)); while (await timer.WaitForNextTickAsync(stop.Token)) { if (await Platform.IsVisible()) { await Platform.StartRealtime(); await InvokeAsync(async () => { await Refresh(); StateHasChanged(); }); } } } catch (OperationCanceledException) { } }
    async Task Refresh(bool refreshSession = true) { if (session?.Id != null) { if (refreshSession) session = await Api.Get<Session>("session"); var counts = await Api.Get<UnreadCounts>("unread"); unread = counts.Notifications; unreadMessages = counts.Messages; } }
    void Changed() => _ = InvokeAsync(async () => { try { await Refresh((Platform.LastChange & ChangeArea.Profiles) != 0); StateHasChanged(); } catch { } });
    void Location(object? sender, LocationChangedEventArgs e) { boundary?.Recover(); Changed(); }
    public void Dispose() { stop.Cancel(); stop.Dispose(); Platform.Changed -= Changed; Nav.LocationChanged -= Location; }
}


