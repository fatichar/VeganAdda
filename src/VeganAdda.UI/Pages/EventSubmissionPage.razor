@page "/events/post"
@page "/events/post/{Id:guid}"
@page "/events/suggest"
@page "/events/suggest/{Id:guid}"
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inherits Screen
<PageTitle>Post an event · VeganAdda</PageTitle>
<div class="narrow"><a class="back-link" href="/events"><Icon Name="arrow_back" />Events</a><h1>Post an event</h1><Feedback Error="@Error" Success="@Success" />
@if (Session?.Id == null) { <Empty Title="Sign in to post an event" Text="Verified vegan members can post events."><a class="button" href="@($"/signin?returnUrl={E(Current)}")">Sign in</a></Empty> }
else if (!Session.BasicProfileComplete) { <Empty Title="Complete your basic profile first" Text="Verified vegan members can post events."><a class="button" href="@($"/onboarding?returnUrl={E(Current)}")">Create profile</a></Empty> }
else if (profile?.IsVegan == false) { <Empty Title="Event posting is for verified vegan members"><a class="button secondary" href="/settings/profile">Edit profile</a></Empty> }
else if (profile != null && profile.IsVegan is null) { <Empty Title="Choose your vegan status first" Text="Set your status in your profile before posting an event."><a class="button secondary" href="/settings/profile">Update profile</a></Empty> }
else if (profile?.VeganStatusUnverified == true) { <Empty Title="Vegan status is unverified" Text="Request vegan verification from your profile before posting an event."><a class="button secondary" href="/settings/profile">View profile status</a></Empty> }
else if (profile != null) {
    <p class="small muted">Events publish immediately. Share public event details only.</p>
    @if (edit != null) {
        <form @key="edit" class="form-card event-submission" @onsubmit="Save" @onsubmit:preventDefault><fieldset class="interactive-form" disabled="@(!RendererInfo.IsInteractive)">
            <h2>@(edit.Id == Guid.Empty ? "Event details" : "Edit event")</h2>
            <label for="event-title">Event name <RequiredMark /></label><input id="event-title" required maxlength="150" @bind="edit.Title" @bind:event="oninput" />
            <label for="event-description">Description <span class="muted">(optional)</span></label><textarea id="event-description" rows="5" maxlength="4000" @bind="edit.Description" @bind:event="oninput"></textarea>
            <label for="event-cover">Cover image <span class="muted">(optional)</span></label><InputFile id="event-cover" OnChange="Upload" accept="image/jpeg,image/png,image/webp" />
            @if (edit.Cover != "") { <img class="admin-cover" src="@edit.Cover" alt="Event cover preview" /> }
            <LocationPicker Model="eventPlace" ProfileLocation="false" BusyChanged="value => locationBusy = value" />
            <label for="event-venue">Venue <RequiredMark /></label><input id="event-venue" required maxlength="200" @bind="edit.Venue" @bind:event="oninput" />
            <EventContactPicker Model="edit" Poster="@(new EventContact(Session.Id.Value, Session.Name))" />
            <p class="small muted">Times are local to the event venue.</p>
            <label for="event-start">Start date and time <RequiredMark /></label><input id="event-start" type="datetime-local" required @bind="start" />
            <label for="event-end">End date and time <span class="muted">(optional)</span></label><input id="event-end" type="datetime-local" @bind="end" />
            <label for="event-registration">Official information / registration link <span class="muted">(optional)</span></label><input id="event-registration" type="url" @bind="edit.Registration" @bind:event="oninput" placeholder="https://" />
            <div class="actions"><button disabled="@(Busy || locationBusy)">@(Busy ? "Saving…" : edit.Published ? "Save changes" : "Publish event")<Icon Name="arrow_forward" /></button></div>
        </fieldset></form>
    }
    <div class="section-heading"><h2>Your events</h2><button class="secondary" @onclick="NewEvent" disabled="@Busy">New event</button></div>
    @if (submissions.Count == 0) { <p class="muted">You haven’t posted any events yet.</p> }
    @foreach (var item in submissions.Skip((submissionPage - 1) * 12).Take(12))
    {
        <article class="card admin-row" @key="item.Id">
            <div>
                @if (item.Published) { <strong><a href="/events/@item.Id">@item.Title</a></strong> }
                else { <strong>@item.Title</strong> }
                <small>@item.City · @item.SubmissionStatus</small>
                @if (item.ReviewNote != null) { <small class="error-text">@item.ReviewNote</small> }
            </div>
            @if (CanEdit(item)) { <button class="secondary small-button" disabled="@Busy" @onclick="() => Edit(item)">Edit</button> }
        </article>
    }
    <Pagination PageNumber="@submissionPage" Total="@submissions.Count" Busy="@Busy" PageChanged="SetSubmissionPage" />
}
</div>
@code {
    [Parameter] public Guid? Id { get; set; }
    ProfileInput eventPlace = new(); bool locationBusy; ProfileInput? profile; List<EventInput> submissions = []; EventInput? edit; DateTime? start, end; int submissionPage = 1;
    protected override async Task OnInitializedAsync() { await base.OnInitializedAsync(); if (Session?.Id != null && Session.BasicProfileComplete) await Run(Refresh); }
    protected override async Task Refresh()
    {
        profile = await Profiles.GetProfile();
        submissions = await Api.Get<List<EventInput>>("event-submissions");
        submissionPage = Math.Min(submissionPage, Math.Max(1, (submissions.Count + 11) / 12));
    }
    protected override void OnParametersSet()
    {
        if (edit != null && Id == lastRouteId) return;
        lastRouteId = Id;
        var item = submissions.FirstOrDefault(x => x.Id == Id && CanEdit(x));
        if (item != null) Edit(item);
        else NewEvent();
    }
    Guid? lastRouteId;
    static bool CanEdit(EventInput item) => item.Published || item.SubmissionStatus is "Pending review" or "Draft";
    Task SetSubmissionPage(int value) { submissionPage = value; return Task.CompletedTask; }
    void NewEvent() { edit = new(); eventPlace = new() { Country = profile?.Country ?? "India", State = profile?.State ?? "", City = profile?.City ?? "" }; start = end = null; }
    void Edit(EventInput item) { edit = JsonSerializer.Deserialize<EventInput>(JsonSerializer.Serialize(item, Wire.Json), Wire.Json); eventPlace = new() { Country = item.Country, State = item.State, City = item.City }; var zone = TimeZoneInfo.FindSystemTimeZoneById(item.TimeZone); start = item.Start.HasValue ? TimeZoneInfo.ConvertTime(item.Start.Value, zone).DateTime : null; end = item.End.HasValue ? TimeZoneInfo.ConvertTime(item.End.Value, zone).DateTime : null; }
    Task Save() => Act(async () =>
    {
        if (edit == null || locationBusy) return;
        var wasPublished = edit.Published;
        edit.Country = eventPlace.Country;
        edit.State = eventPlace.State;
        edit.City = eventPlace.City;
        edit.LocalStart = start;
        edit.LocalEnd = end;
        await Api.Send<Ok>("event-submissions", edit);
        NewEvent();
        Success = wasPublished ? "Your event was updated." : "Your event is published.";
        await Refresh();
    });
    Task Upload(InputFileChangeEventArgs e) => Run(async () => { if (e.File.Size > 10 * 1024 * 1024) throw new ApiException(400, "Choose an image smaller than 10 MB."); var (stream, name, contentType) = await ImageResizer.ProcessUpload(JS, e, "event-cover"); await using (stream) { edit!.Cover = await Platform.Upload(stream, name, contentType); } });
}
