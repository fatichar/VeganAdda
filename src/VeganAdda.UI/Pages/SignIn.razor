@page "/signin"
@inherits Screen
<PageTitle>Welcome · VeganAdda</PageTitle>
<div class="auth-layout"><section class="auth-card"><h1>Find your vegan people.</h1><Feedback Error="@Error" />
@if (AuthError != null) { <div class="feedback error" role="alert">Google sign-in couldn't be completed. Please try again.</div> }
@if (Session?.AuthConfigured == true) { <button class="google-button" disabled="@Busy" @onclick="Google"><Icon Name="login" />Continue with Google<Icon Name="arrow_forward" /></button> }
else { <div class="notice"><strong>Sign-in is coming soon.</strong><p>You can explore the community in the meantime.</p><a href="/">Explore the community<Icon Name="arrow_forward" /></a></div> }
<p class="small muted">By continuing, you agree to our <a href="/terms">Terms</a> and <a href="/privacy">Privacy Policy</a>. For adults 18+.</p>
@if (Session?.Development == true) { <details class="dev-login"><summary>Development-only test accounts</summary><p class="small">Fictional accounts for local testing.</p><div class="test-accounts">@foreach (var name in new[] { "aarav", "ananya", "rohan", "sunita", "kabir", "new", "admin" }) { <button class="secondary" disabled="@Busy" @onclick="() => DevLogin(name)">@name</button> }</div></details> }
</section></div>
@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? AuthError { get; set; }
    string Target => ReturnUrl is { Length: > 0 } && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") && !ReturnUrl.Contains('\\') ? ReturnUrl : "/";
    Task Google() => Run(() => Platform.SignInWithGoogle(Target));
    Task DevLogin(string name) => Run(async () => { await Api.Send<Ok>("auth/dev/" + name); var session = await Api.Get<Session>("session"); Nav.NavigateTo(session.HasProfile ? Target : "/onboarding?returnUrl=" + E(Target), true); });
}

