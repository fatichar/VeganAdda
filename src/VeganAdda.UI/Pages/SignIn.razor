@page "/signin"
@inherits Screen
<PageTitle>Welcome · VeganAdda</PageTitle>
<div class="auth-layout"><section class="auth-card"><h1>Find your vegan people.</h1><p class="auth-intro">VeganAdda is a community built for vegans to meet, connect, and take part in community life.</p><Feedback Error="@Error" />
@if (AuthError != null) { <div class="feedback error" role="alert">Google sign-in couldn't be completed. Please try again.</div> }
@if (Session?.AuthConfigured == true) { <button class="google-button" disabled="@(Busy || !RendererInfo.IsInteractive)" @onclick="Google"><Icon Name="login" />@(RendererInfo.IsInteractive ? (Busy ? "Signing in…" : "Continue with Google") : "Preparing sign-in…")<Icon Name="arrow_forward" /></button> }
else { <div class="notice"><strong>Sign-in is coming soon.</strong><p>You can explore the community in the meantime.</p><a href="/">Explore the community<Icon Name="arrow_forward" /></a></div> }
<p class="small muted">By continuing, you agree to our <a href="/terms">Terms</a> and <a href="/privacy">Privacy Policy</a>. For adults 18+. If you are not vegan but interested in meeting vegans, you are welcome to join. Some features are reserved for vegan members, so non-vegan accounts have restricted access.</p>
@if (Session?.Development == true) { <details class="dev-login"><summary>Development-only test accounts</summary><p class="small">Fictional accounts for local testing. Choose any profile to sign in without Google.</p><div class="test-accounts">@foreach (var name in new[] { "aarav", "ananya", "rohan", "sunita", "kabir", "new", "meera", "dev", "isha", "arjun", "admin" }) { <button class="secondary" disabled="@(Busy || !RendererInfo.IsInteractive)" @onclick="() => DevLogin(name)">@name</button> }</div></details> }
</section></div>
@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? AuthError { get; set; }
    string Target => ReturnUrl is { Length: > 0 } && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") && !ReturnUrl.Contains('\\') ? ReturnUrl : "/";
    Task Google() => Run(() => Platform.SignInWithGoogle(Target));
    Task DevLogin(string name) => Run(async () => { await Api.Send<Ok>("auth/dev/" + name); var session = await Api.Get<Session>("session"); Nav.NavigateTo(ProfileSetup.SignInDestination(session.BasicProfileComplete, Target), true); });
}
