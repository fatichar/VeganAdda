@page "/onboarding"
@page "/settings/profile"
@inherits Screen
<PageTitle>Your profile · VeganAdda</PageTitle>
<div class="narrow"><a class="back-link" href="/settings"><Icon Name="arrow_back" />Back</a><h1>@(onboarding ? "Create your profile" : "Edit profile")</h1><Feedback Error="@Error" Success="@Success" />
@if (onboarding) { <p class="notice">VeganAdda is a community for vegans. If you are not vegan but interested in meeting vegans, you are welcome with limited access.</p> }
@if (Session?.Id == null) { <a class="button" href="@SignInUrl">Sign in to create a profile</a> }
else if (model != null) {
@if (onboarding && !string.IsNullOrWhiteSpace(ReferralCode)) { <p class="notice">A verified community member referred you. A moderator will review your profile before it appears.</p> }
@if (model.VeganVerificationPending) { <div class="notice" role="status"><strong>Your vegan status is being reviewed.</strong><p>Your profile will stay out of discovery until a moderator completes verification.</p></div> }
@if (changingToVegan) { <div class="notice" role="status"><strong>This change needs moderator verification.</strong><p>Your profile will stay out of discovery until the review is complete.</p></div> }
@if (Session.HasProfile && !model.Approved) { <div class="notice" role="status"><strong>@(model.ReviewNote == null ? "Your profile is awaiting review." : "Your profile needs an update.")</strong>@if (model.ReviewNote != null) { <p>@model.ReviewNote</p> }<p>Your profile will appear in discovery after a moderator approves it. Saving changes sends it for review again.</p></div> }
<form @onsubmit="Save" @onsubmit:preventDefault class="form-card"><fieldset class="interactive-form" disabled="@(!RendererInfo.IsInteractive)"><div class="profile-photo-field"><Avatar Name="@model.Name" Photo="@model.Photo" Size="large" /><div><label for="photo">Profile photo <span class="muted">(optional)</span></label><InputFile id="photo" OnChange="Upload" accept="image/jpeg,image/png,image/webp" /><small>JPG, PNG or WebP · up to 2 MB</small>@if (model.Photo != "") { <button type="button" class="text-button" @onclick="() => model.Photo = string.Empty">Remove photo</button> }</div></div>
<fieldset class="vegan-status">
    <legend>Vegan status</legend>
    <p class="small muted">VeganAdda is a community for vegans. Non-vegan members are welcome, with limited access to some features.</p>
    <label class="check-row"><input type="radio" name="vegan-status" required checked="@(model.IsVegan == true)" @onchange="() => model.IsVegan = true" /><span>I am a vegan</span></label>
    <label class="check-row"><input type="radio" name="vegan-status" required checked="@(model.IsVegan == false)" @onchange="() => model.IsVegan = false" /><span>I am not a vegan but interested in meeting vegans</span></label>
</fieldset>
@if (model.IsVegan == false) { <p class="small muted">Non-vegan members can connect with vegans and appear when someone includes non-vegan profiles in discovery. They cannot submit events or moderate.</p> }
<label for="name">Your name</label><input id="name" required maxlength="80" autocomplete="name" @bind="model.Name" @bind:event="oninput" placeholder="Name" />
<BirthDetails Model="@model" />
<LocationPicker Model="@model" BusyChanged="value => locationBusy = value" />
<fieldset><legend>What are you looking for?</legend>@foreach (var intention in Wire.Intents) { <label class="check-row"><input type="checkbox" checked="@model.LookingFor.Contains(intention)" @onchange="e => Intent(intention, e)" /><Icon Name="@(intention == "Dating" ? "favorite_border" : intention == "Activism" ? "volunteer_activism" : intention == "Friendship" ? "diversity_1" : "handshake")" /><span>@intention @if (intention == "Dating") { <small>Private opt-in · visible only to other members who opt in</small> }</span></label> }</fieldset>
<label for="bio">About you <span class="muted">(optional)</span></label><textarea id="bio" rows="4" maxlength="1000" @bind="model.Bio" @bind:event="oninput" placeholder="Your passions, favourite plant-based spots, or what brings you here…"></textarea>
<label for="interests">Interests <span class="muted">(optional)</span></label><input id="interests" @bind="interests" @bind:event="oninput" maxlength="400" placeholder="Running, baking, volunteering…" /><small>Comma-separated · up to 10 interests</small>
<details class="optional-fields"><summary>Website & social links (optional)</summary><label for="instagram">Instagram</label><input id="instagram" type="url" @bind="model.Instagram" @bind:event="oninput" placeholder="https://instagram.com/yourname" /><label for="linkedin">LinkedIn</label><input id="linkedin" type="url" @bind="model.LinkedIn" @bind:event="oninput" placeholder="https://linkedin.com/in/yourname" /><label for="website">Website</label><input id="website" type="url" @bind="model.Website" @bind:event="oninput" placeholder="https://" /><small>Links are shared on your profile. They are not identity verification.</small></details>
<fieldset><legend>Visibility</legend><label class="check-row"><input type="checkbox" @bind="model.Public" /><span>Show my profile to public visitors<small>Your name, photo, city, state, country, bio, interests, non-dating intentions and links will be public. Dating is always excluded from public responses.</small></span></label><label class="check-row"><input type="checkbox" @bind="model.FeatureConsent" /><span>Allow my public profile to be featured<small>Only applies while public visibility is on.</small></span></label></fieldset>
<label class="check-row age-confirm"><input type="checkbox" required @bind="model.AdultConfirmed" /><span>I confirm I am at least 18 years old.<small>VeganAdda is an adults-only community.</small></span></label><p class="small muted">Keep private contact details out of your bio. Be kind, respect boundaries, and connect with consent.</p><button class="full" disabled="@(Busy || locationBusy)">@(Busy ? "Saving…" : onboarding ? "Complete profile" : "Save changes")<Icon Name="arrow_forward" /></button>
</fieldset></form> }</div>
@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "ref")] public string? ReferralCode { get; set; }
    ProfileInput? model; string interests = ""; bool? originalIsVegan; bool onboarding => Nav.ToBaseRelativePath(Nav.Uri).StartsWith("onboarding"); bool changingToVegan => originalIsVegan == false && model?.IsVegan == true;
    bool locationBusy;
    string SignInUrl => "/signin?returnUrl=" + E(onboarding && !string.IsNullOrWhiteSpace(ReferralCode) ? "/onboarding?ref=" + E(ReferralCode) : "/onboarding");
    protected override async Task OnInitializedAsync() { await base.OnInitializedAsync(); if (Session?.Id != null) await Run(async () => { model = await Profiles.GetProfile(); originalIsVegan = model.IsVegan; if (onboarding) model.ReferralCode = ReferralCode; interests = string.Join(", ", model.Interests); }); }
    void Intent(string intention, ChangeEventArgs e) { model!.LookingFor = (bool)e.Value! ? model.LookingFor.Append(intention).Distinct().ToArray() : model.LookingFor.Where(x => x != intention).ToArray(); }
    Task Save() => Run(async () => { model!.Interests = interests.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries); await Profiles.SaveProfile(model!); if (onboarding) Nav.NavigateTo(ReturnUrl != null && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") && !ReturnUrl.Contains('\\') ? ReturnUrl : "/", true); else { model = await Profiles.GetProfile(); Session = await Api.Get<Session>("session"); originalIsVegan = model.IsVegan; interests = string.Join(", ", model.Interests); Success = model.VeganVerificationPending ? "Your vegan status was submitted for moderator verification." : "Your profile has been updated."; } });
    Task Upload(InputFileChangeEventArgs e) => Run(async () => { var file = e.File; if (file.Size > 2 * 1024 * 1024) { Error = "Please choose an image smaller than 2 MB."; return; } await using var stream = file.OpenReadStream(2 * 1024 * 1024); model!.Photo = await Platform.Upload(stream, file.Name, file.ContentType); Success = "Photo ready. Save your profile to keep it."; });
}


