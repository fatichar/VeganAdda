@page "/onboarding"
@page "/settings/profile"
@inherits Screen
<PageTitle>Your profile · VeganAdda</PageTitle>
<div class="narrow"><a class="back-link" href="/settings"><Icon Name="arrow_back" />Back</a><h1>@(onboarding ? "Create your profile" : "Edit profile")</h1><Feedback Error="@Error" Success="@Success" />
@if (Session?.Id == null) { <a class="button" href="/signin?returnUrl=%2Fonboarding">Sign in to create a profile</a> }
else if (model != null) {
<form @onsubmit="Save" @onsubmit:preventDefault class="form-card"><fieldset class="interactive-form" disabled="@(!RendererInfo.IsInteractive)"><div class="profile-photo-field"><Avatar Name="@model.Name" Photo="@model.Photo" Size="large" /><div><label for="photo">Profile photo <span class="muted">(optional)</span></label><InputFile id="photo" OnChange="Upload" accept="image/jpeg,image/png,image/webp" /><small>JPG, PNG or WebP · up to 2 MB</small>@if (model.Photo != "") { <button type="button" class="text-button" @onclick="() => model.Photo = string.Empty">Remove photo</button> }</div></div>
<label for="name">Your name</label><input id="name" required maxlength="80" autocomplete="name" @bind="model.Name" @bind:event="oninput" placeholder="Name" />
<label for="city">Your city</label><input id="city" required maxlength="80" list="city-options" @bind="model.City" @bind:event="oninput" /><datalist id="city-options">@foreach (var c in Wire.Cities.Where(x => x != "All India")) { <option value="@c" /> }</datalist>
<fieldset><legend>What are you looking for?</legend>@foreach (var intention in Wire.Intents) { <label class="check-row"><input type="checkbox" checked="@model.LookingFor.Contains(intention)" @onchange="e => Intent(intention, e)" /><Icon Name="@(intention == "Dating" ? "favorite_border" : intention == "Activism" ? "volunteer_activism" : intention == "Friendship" ? "diversity_1" : "handshake")" /><span>@intention @if (intention == "Dating") { <small>Private opt-in · visible only to other members who opt in</small> }</span></label> }</fieldset>
<label for="bio">About you <span class="muted">(optional)</span></label><textarea id="bio" rows="4" maxlength="1000" @bind="model.Bio" @bind:event="oninput" placeholder="Your passions, favourite plant-based spots, or what brings you here…"></textarea>
<label for="interests">Interests <span class="muted">(optional)</span></label><input id="interests" @bind="interests" @bind:event="oninput" maxlength="400" placeholder="Running, baking, volunteering…" /><small>Comma-separated · up to 10 interests</small>
<details class="optional-fields"><summary>Website & social links (optional)</summary><label for="instagram">Instagram</label><input id="instagram" type="url" @bind="model.Instagram" @bind:event="oninput" placeholder="https://instagram.com/yourname" /><label for="linkedin">LinkedIn</label><input id="linkedin" type="url" @bind="model.LinkedIn" @bind:event="oninput" placeholder="https://linkedin.com/in/yourname" /><label for="website">Website</label><input id="website" type="url" @bind="model.Website" @bind:event="oninput" placeholder="https://" /><small>Links are shared on your profile. They are not identity verification.</small></details>
<fieldset><legend>Visibility</legend><label class="check-row"><input type="checkbox" @bind="model.Public" /><span>Show my profile to public visitors<small>Your name, photo, city, bio, interests, non-dating intentions and links will be public. Dating is always excluded from public responses.</small></span></label><label class="check-row"><input type="checkbox" @bind="model.FeatureConsent" /><span>Allow my public profile to be featured<small>Only applies while public visibility is on.</small></span></label></fieldset>
<label class="check-row age-confirm"><input type="checkbox" required @bind="model.AdultConfirmed" /><span>I confirm I am at least 18 years old.<small>VeganAdda is an adults-only community.</small></span></label><p class="small muted">Keep private contact details out of your bio. Be kind, respect boundaries, and connect with consent.</p><button class="full" disabled="@Busy">@(Busy ? "Saving…" : onboarding ? "Complete profile" : "Save changes")<Icon Name="arrow_forward" /></button>
</fieldset></form> }</div>
@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    ProfileInput? model; string interests = ""; bool onboarding => Nav.ToBaseRelativePath(Nav.Uri).StartsWith("onboarding");
    protected override async Task OnInitializedAsync() { await base.OnInitializedAsync(); if (Session?.Id != null) await Run(async () => { model = await Api.Get<ProfileInput>("profile"); interests = string.Join(", ", model.Interests); }); }
    void Intent(string intention, ChangeEventArgs e) { model!.LookingFor = (bool)e.Value! ? model.LookingFor.Append(intention).Distinct().ToArray() : model.LookingFor.Where(x => x != intention).ToArray(); }
    Task Save() => Run(async () => { model!.Interests = interests.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries); await Api.Send<Ok>("profile", model); if (onboarding) Nav.NavigateTo(ReturnUrl != null && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") && !ReturnUrl.Contains('\\') ? ReturnUrl : "/", true); else Success = "Your profile has been updated."; });
    Task Upload(InputFileChangeEventArgs e) => Run(async () => { var file = e.File; if (file.Size > 2 * 1024 * 1024) { Error = "Please choose an image smaller than 2 MB."; return; } await using var stream = file.OpenReadStream(2 * 1024 * 1024); model!.Photo = await Platform.Upload(stream, file.Name, file.ContentType); Success = "Photo ready. Save your profile to keep it."; });
}


