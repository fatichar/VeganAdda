@page "/"
@using Microsoft.JSInterop
@inherits Screen
@inject IJSRuntime JS
<PageTitle>Discover · VeganAdda</PageTitle>
<div class="discovery">
    @if (Session?.Id == null)
    {
        <section class="visitor-banner public-home-intro">
            <div><strong>VeganAdda — meet your vegan community</strong><p>Discover people, find vegan events, and build local connections. Dating is optional and mutual.</p></div>
            <a class="button secondary" href="/events">Explore events</a>
        </section>
    }
    <h1 class="sr-only">Discover</h1>
    <div class="discovery-heading">
        <LocationFilter Country="@country" State="@state" City="@city" OverrideLabel="@(nearby ? $"Near me · {radius} km" : null)" Profile="profile" Selected="PlaceSelected" NearbyRequested="OpenNearby" />
    </div>
    @if (Session?.Id != null)
    {
        <form class="filter-bar" @onsubmit="Search" @onsubmit:preventDefault>
            <div class="search-field"><label class="sr-only" for="people-search">Search people and interests</label><input id="people-search" type="search" enterkeyhint="search" placeholder="Search people or interests" maxlength="200" @bind="search" @bind:event="oninput" /><button type="submit" class="icon-button search-submit" aria-label="Search"><Icon Name="search" /></button></div>
            <button type="button" class="icon-button secondary filter-toggle" aria-label="Filters" aria-haspopup="dialog" @onclick="OpenFilters"><Icon Name="tune" />@if (HasFilters) { <span class="filter-dot"></span> }</button>
        </form>
        @if (HasFilters)
        {
            <div class="discovery-chips" aria-label="Active filters">
                @if (eventId != "") { <button class="discovery-chip" aria-label="Remove event filter" @onclick='() => RemoveFilter("event")'>@(selectedEvent?.Title ?? "Event")<Icon Name="close" /></button> }
                @if (checkedIn) { <button class="discovery-chip" aria-label="Remove check-in filter" @onclick='() => RemoveFilter("checkin")'>Checked in<Icon Name="close" /></button> }
                @if (intent != "") { <button class="discovery-chip" aria-label="Remove looking for filter" @onclick='() => RemoveFilter("intent")'>@intent<Icon Name="close" /></button> }
                @if (interest != "") { <button class="discovery-chip" aria-label="Remove interest filter" @onclick='() => RemoveFilter("interest")'>@interest<Icon Name="close" /></button> }
                @if (minAge.HasValue || maxAge.HasValue) { <button class="discovery-chip" aria-label="Remove age filter" @onclick='() => RemoveFilter("age")'>Age @(minAge ?? 18)–@(maxAge ?? 120)<Icon Name="close" /></button> }
                @if (verifiedVegansOnly) { <button class="discovery-chip" aria-label="Remove verified vegans filter" @onclick='() => RemoveFilter("verified")'>Verified vegans only<Icon Name="close" /></button> }
                @if (includeNonVegan) { <button class="discovery-chip" aria-label="Remove non-vegan filter" @onclick='() => RemoveFilter("nonvegan")'>Includes non-vegans<Icon Name="close" /></button> }
            </div>
        }
    }
    @if (nearby) { <p class="small discovery-scope">Within @radius km of your current location. Only members with a saved precise location appear.</p> }
    @if (selectedEvent != null) { <p class="small discovery-scope"><a href="/events/@selectedEvent.Id">@selectedEvent.Title</a> · @(checkedIn ? "Self-reported check-ins. Refresh to update." : "Members who opted into the attendee list.") <button class="text-button" disabled="@Busy" @onclick="Search">Refresh</button></p> }
    @if (Session?.Id != null && Session.IsVegan == null) { <div class="notice" role="status">Choose your vegan status to finish setting up your member profile. <a href="/settings/profile">Update your profile</a>.</div> }
    <Feedback Error="@Error" Success="@Success" />
    @if (!Loaded || Busy) { <p role="status" class="loading">Finding people…</p> }
    else if (people.Count == 0) { <Empty Title="@(checkedIn ? "No checked-in people found" : "No people found")" Text="@(eventId != "" ? "Members appear after opting into attendance visibility. Try refreshing or adjusting your filters." : "Try a wider location or adjust your filters.")"><button class="secondary" @onclick="Search">Refresh</button><button class="text-button" @onclick="ClearFilters">Reset filters</button></Empty> }
    else { <div class="people-grid">@foreach (var p in people) { <PersonCard Person="p" Viewer="Session?.Id" Connect="Connect" Save="Save" Discovery="true" /> }</div> }
    <Pagination PageNumber="@(page)" Total="@total" Busy="@Busy" PageChanged="SetPage" />
    <ConnectDialog Person="connecting" Closed="() => connecting = null" Sent="Connected" />
</div>
<DiscoveryPanel Open='@(panel != "")' Title="@PanelTitle" Closed="ClosePanel">
    @if (panel == "nearby")
    {
        <form @onsubmit="UseNearby" @onsubmit:preventDefault>
            <label for="discovery-radius">Distance: @draftRadius km</label>
            <input id="discovery-radius" type="range" min="5" max="200" step="5" @bind="draftRadius" @bind:event="oninput" />
            <div class="radius-labels"><span>5 km</span><span>200 km</span></div>
            <p class="small">Your current location is used for this search only. It won't update your saved profile location.</p>
            <Feedback Error="@panelError" />
            <button class="full" disabled="@locating"><Icon Name="my_location" />@(locating ? "Finding location…" : "Use current location")</button>
            <button type="button" class="text-button full" @onclick='() => { locating = false; panel = "place"; }'>Choose a city instead</button>
        </form>
    }
    else if (panel == "place")
    {
        <DiscoveryPlacePicker Country="@country" State="@state" City="@city" Selected="PlaceSelected" />
    }
    else if (panel == "filters")
    {
        <form @onsubmit="ApplyFilters" @onsubmit:preventDefault class="discovery-filter-form">
            <label for="discovery-event">Event</label><select id="discovery-event" @bind="draftEvent" disabled="@eventsLoading"><option value="">@(eventsLoading ? "Loading events…" : "All people")</option>@foreach (var item in eventOptions) { <option value="@item.Id">@EventLabel(item)</option> }</select>
            @if (!eventsLoading && eventOptions.Count == 0 && panelError == "") { <small>No published events yet.</small> }
            <label class="check-row"><input type="checkbox" @bind="draftCheckedIn" disabled="@(draftEvent == "")" /><span>Checked-in people only</span></label>
            <fieldset><legend>Age</legend><AgeRange @bind-Min="draftMinAge" @bind-Max="draftMaxAge" /><small>Profiles without an age won't appear when an age filter is set.</small></fieldset>
            <label for="intent">Looking for</label><select id="intent" @bind="draftIntent"><option value="">Any connection</option>@foreach (var tag in Wire.Intents.Where(x => x != "Dating" || dating)) { <option>@tag</option> }</select>
            <label for="interest">Interest</label><select id="interest" @bind="draftInterest"><option value="">All interests</option>@foreach (var tag in new[] { "Running", "Baking", "Sanctuaries", "Design", "Hiking", "Cooking", "Volunteering", "Photography" }) { <option>@tag</option> }</select>
            <label class="check-row"><input type="checkbox" @bind="draftVerifiedVegansOnly" /><span>Verified vegans only</span></label>
            <label class="check-row"><input type="checkbox" @bind="draftNonVegan" /><span>Include non-vegan profiles</span></label>
            <Feedback Error="@panelError" />
            <div class="discovery-panel-actions"><button type="button" class="text-button" @onclick="ResetDraftFilters">Reset filters</button><button type="submit" disabled="@eventsLoading">Show people</button></div>
        </form>
    }
</DiscoveryPanel>
@code {
    protected override ChangeArea ChangeInterests => ChangeArea.Profiles | ChangeArea.Events | ChangeArea.Connections;
    [SupplyParameterFromQuery] public string? City { get; set; }
    [SupplyParameterFromQuery(Name = "event")] public string? Event { get; set; }
    [SupplyParameterFromQuery(Name = "checkedIn")] public bool CheckedIn { get; set; }
    string eventId = "", draftEvent = ""; bool checkedIn, draftCheckedIn;
    string? lastEvent; bool lastCheckedIn;
    EventCard? selectedEvent; List<EventCard> eventOptions = []; bool eventsLoading;
    string country = "", state = "", city = "", search = "", interest = "", intent = "", panel = "", panelError = "";
    string draftIntent = "", draftInterest = "";
    bool verifiedVegansOnly, draftVerifiedVegansOnly;
    bool dating, includeNonVegan, draftNonVegan, nearby, locating; int page = 1, total, radius = 25, draftRadius = 25;
    int? minAge, maxAge, draftMinAge, draftMaxAge;
    double? latitude, longitude;
    ProfileInput? profile; string? lastCity; int locationRequest;
    bool locationReady;
    List<Person> people = []; Person? connecting;
    bool HasFilters => eventId != "" || interest != "" || intent != "" || includeNonVegan || verifiedVegansOnly || minAge.HasValue || maxAge.HasValue;
    string PanelTitle => panel == "filters" ? "Filters" : panel == "nearby" ? "Near me" : panel == "place" ? "Choose location" : "Discover where?";
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        if (Session?.BasicProfileComplete == true) await Run(async () =>
        {
            profile = await Profiles.GetProfile(); dating = profile.LookingFor.Contains("Dating");
        });
    }
    protected override async Task OnParametersSetAsync()
    {
        if (City != lastCity) { lastCity = City; nearby = false; country = state = ""; city = City == "All India" ? "" : City ?? ""; page = 1; }
        if (Event != lastEvent || CheckedIn != lastCheckedIn)
        {
            lastEvent = Event; lastCheckedIn = CheckedIn; eventId = Event ?? ""; checkedIn = eventId != "" && CheckedIn; selectedEvent = null; page = 1;
            if (eventId != "") { country = state = city = ""; nearby = false; latitude = longitude = null; }
        }
        if (locationReady) await Run(Refresh);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender) return;
        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/VeganAdda.UI/discovery.js");
            var saved = await module.InvokeAsync<DiscoveryInput?>("loadPlace");
            if (City == null && Event == null && saved != null)
            {
                country = saved.Country; state = saved.State; city = saved.City;
            }
        }
        catch (JSException) { }
        locationReady = true;
        await Run(Refresh);
        await InvokeAsync(StateHasChanged);
    }
    protected override async Task Refresh()
    {
        if (eventId != "" && selectedEvent?.Id.ToString() != eventId) selectedEvent = await Api.Get<EventCard>("events/" + eventId);
        Page<Person> result;
        if (nearby)
            result = await Profiles.SearchPeople( new DiscoveryInput { Event = eventId, CheckedIn = checkedIn, Latitude = latitude, Longitude = longitude, RadiusKm = radius, Search = search, Interest = interest, Intent = intent, IncludeNonVegan = includeNonVegan, VerifiedVegansOnly = verifiedVegansOnly, MinAge = minAge, MaxAge = maxAge, Page = page });
        else
            result = await Profiles.SearchPeople(new DiscoveryInput { Event = eventId, CheckedIn = checkedIn, Country = country, State = state, City = city, Search = search, Interest = interest, Intent = intent, IncludeNonVegan = includeNonVegan, VerifiedVegansOnly = verifiedVegansOnly, MinAge = minAge, MaxAge = maxAge, Page = page });
        people = result.Items; total = result.Total;
    }
    void OpenPanel(string value) { panelError = ""; panel = value; }
    void ClosePanel() { panel = ""; panelError = ""; locating = false; locationRequest++; }
    void OpenNearby()
    {
        if (Session?.Id == null) { Platform.SignIn("/"); return; }
        draftRadius = radius; OpenPanel("nearby");
    }
    async Task PlaceSelected(DiscoveryInput place)
    {
        country = place.Country; state = place.State; city = place.City;
        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/VeganAdda.UI/discovery.js");
            await module.InvokeVoidAsync("savePlace", new DiscoveryInput { Country = country, State = state, City = city });
        }
        catch (JSException) { }
        nearby = false; latitude = longitude = null; ClosePanel(); await Search();
    }
    public record CurrentPosition(double? Latitude, double? Longitude, string Error = "");
    async Task UseNearby()
    {
        if (locating) return;
        locating = true; panelError = ""; var request = ++locationRequest;
        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/VeganAdda.UI/discovery.js");
            var position = await module.InvokeAsync<CurrentPosition>("currentPosition");
            if (request != locationRequest || !locating || panel != "nearby") return;
            if (position.Error != "" || !position.Latitude.HasValue || !position.Longitude.HasValue) { panelError = position.Error != "" ? position.Error : "Location couldn't be found. Choose a city instead."; return; }
            latitude = position.Latitude; longitude = position.Longitude; radius = draftRadius; nearby = true; country = state = city = "";
            ClosePanel(); await Search();
        }
        catch (JSException) { panelError = "Location couldn't be found. Try again or choose a city."; }
        finally { if (request == locationRequest) locating = false; }
    }
    async Task OpenFilters()
    {
        draftEvent = eventId; draftCheckedIn = checkedIn;
        draftVerifiedVegansOnly = verifiedVegansOnly; draftIntent = intent; draftInterest = interest; draftNonVegan = includeNonVegan; draftMinAge = minAge; draftMaxAge = maxAge; OpenPanel("filters");
        eventsLoading = true; eventOptions = [];
        try
        {
            for (var eventPage = 1; ; eventPage++)
            {
                var result = await Api.Get<Page<EventCard>>($"events?includePast=true&page={eventPage}");
                eventOptions.AddRange(result.Items.Where(e => eventOptions.All(existing => existing.Id != e.Id)));
                if (result.Items.Count == 0 || eventPage * result.PageSize >= result.Total) break;
            }
            if (selectedEvent != null && eventOptions.All(e => e.Id != selectedEvent.Id)) eventOptions.Add(selectedEvent);
        }
        catch (ApiException ex) { panelError = ex.Message; }
        catch (HttpRequestException) { panelError = "Events couldn't load. Close filters and try again."; }
        finally { eventsLoading = false; }
    }
    static string EventLabel(EventCard item) => $"{item.Title} · {item.City} · {(item.Start.HasValue ? TimeZoneInfo.ConvertTime(item.Start.Value, TimeZoneInfo.FindSystemTimeZoneById(item.TimeZone)).ToString("d MMM yyyy") : "Date to be confirmed")}";
    async Task ApplyFilters()
    {
        if (draftMinAge is < 18 or > 120 || draftMaxAge is < 18 or > 120 || draftMinAge > draftMaxAge) { panelError = "Choose an age range between 18 and 120, with From no higher than To."; return; }
        verifiedVegansOnly = draftVerifiedVegansOnly; intent = draftIntent; interest = draftInterest; includeNonVegan = draftNonVegan; minAge = draftMinAge; maxAge = draftMaxAge; ClosePanel();
        if (draftEvent != eventId || (draftEvent != "" && draftCheckedIn != checkedIn)) NavigateEvent(draftEvent, draftCheckedIn);
        else await Search();
    }
    void NavigateEvent(string id, bool onlyCheckedIn) => Nav.NavigateTo(id == "" ? "/" : $"/?event={E(id)}&checkedIn={onlyCheckedIn.ToString().ToLowerInvariant()}");
    void ResetDraftFilters() { draftEvent = draftIntent = draftInterest = panelError = ""; draftCheckedIn = draftNonVegan = false; draftVerifiedVegansOnly = false; draftMinAge = draftMaxAge = null; }
    Task ClearFilters() { search = interest = intent = ""; includeNonVegan = false; verifiedVegansOnly = false; minAge = maxAge = null; if (eventId != "") { NavigateEvent("", false); return Task.CompletedTask; } return Search(); }
    Task RemoveFilter(string filter)
    {
        if (filter == "event" || filter == "checkin") { NavigateEvent(filter == "event" ? "" : eventId, false); return Task.CompletedTask; }
        if (filter == "verified") verifiedVegansOnly = false; else if (filter == "intent") intent = ""; else if (filter == "interest") interest = ""; else if (filter == "age") minAge = maxAge = null; else includeNonVegan = false;
        return Search();
    }
    Task Search() { page = 1; return Run(Refresh); }
    Task SetPage(int value) { page = value; return Run(Refresh); }
    Task Connect(Person p) { if (Session?.Id == null) Platform.SignIn($"/people/{p.Id}?action=connect"); else if (!Session.BasicProfileComplete) Nav.NavigateTo($"/onboarding?returnUrl={E($"/people/{p.Id}?action=connect")}"); else connecting = p; return Task.CompletedTask; }
    async Task Save(Person p) { if (!ReadyForAction($"/people/{p.Id}?action=save")) return; await Act(async () => { await Api.Send<Ok>($"people/{p.Id}/save"); await Refresh(); Success = p.Saved ? "Profile unsaved." : "Profile saved."; }); }
    async Task Connected() { Success = "Request sent."; await Run(Refresh); }
}
