@page "/events"
@inherits Screen
<PageTitle>Community gatherings · VeganAdda</PageTitle>
<div class="discovery-heading"><h1 class="sr-only">Events</h1><label class="city-picker"><Icon Name="location_on" /><span class="sr-only">City</span><select @bind="City" @bind:after="Filter">@foreach (var city in Wire.Cities) { <option>@city</option> }</select></label></div><a class="button secondary event-suggest" href="/events/suggest"><Icon Name="add" />Suggest an event</a><Feedback Error="@Error" Success="@Success" />
@if (!Loaded || Busy) { <p class="loading" role="status">Loading events…</p> }
else if (items.Count == 0) { <Empty Icon="festival" Title="No upcoming events" Text="Check back soon for events in your city." /> }
else { <div class="events-grid">@foreach (var ev in items) { <EventCardView Event="ev" Save="Save" /> }</div> }
@if (total > 12) { <div class="pagination"><button class="secondary" disabled="@(page == 1 || Busy)" @onclick="Previous">Previous</button><span>Page @(page)</span><button class="secondary" disabled="@(page * 12 >= total || Busy)" @onclick="Next">Next</button></div> }
<a href="/help" class="text-button suggest-event">Suggest an event<Icon Name="arrow_forward" /></a>
@code {
    [SupplyParameterFromQuery] public string City { get; set; } = "All India";
    List<EventCard> items = []; int page = 1, total;
    protected override async Task OnInitializedAsync() { await base.OnInitializedAsync(); }
    protected override Task OnParametersSetAsync() => Run(Refresh);
    protected override async Task Refresh() { var result = await Api.Get<Page<EventCard>>($"events?city={E(City)}&page={page}"); items = result.Items; total = result.Total; }
    Task Filter() { page = 1; return Run(Refresh); }
    Task Previous() { page--; return Run(Refresh); } Task Next() { page++; return Run(Refresh); }
    async Task Save(EventCard ev) { if (!ReadyForAction($"/events/{ev.Id}?action=save")) return; await Act(async () => { await Api.Send<Ok>($"events/{ev.Id}/save"); await Refresh(); Success = "Your saved events are updated."; }); }
}



