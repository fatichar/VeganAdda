@page "/settings"
@inherits Screen
<PageTitle>Settings · VeganAdda</PageTitle>
<div class="narrow settings"><h1>Settings</h1><Feedback Error="@Error" Success="@Success" />
@if (Session?.Id == null) { <Empty Title="Make yourself at home" Text="Sign in to create a profile and manage your settings."><a href="/signin?returnUrl=%2Fsettings" class="button">Sign in</a></Empty> }
else if (model != null) { <div class="settings-identity"><Avatar Name="@Session.Name" Photo="@model.Photo" /><div><h2>@Session.Name</h2><p class="muted">@model.City</p></div></div><span class="eyebrow">Account & profile</span><section class="settings-group"><a class="settings-row" href="/settings/profile"><Icon Name="badge" /><div><strong>Edit your profile</strong></div><Icon Name="chevron_right" /></a><a class="settings-row" href="/saved"><Icon Name="bookmark_border" /><div><strong>Saved</strong></div><Icon Name="chevron_right" /></a></section>
@if (model.CanRefer)
{
    <span class="eyebrow">Invite someone</span>
    <section class="settings-group referral-invite" aria-label="Invite someone">
        <p class="small muted">Invite a person who does not use social accounts. Your referral will be visible to moderators during profile review.</p>
        <button class="secondary" disabled="@Busy" @onclick="CreateReferral">Create referral link</button>
        @if (referralLink != null)
        {
            <div class="referral-result" role="status">
                <label for="referral-link">One-time link · expires in 30 days</label>
                <input id="referral-link" readonly value="@referralLink" />
            </div>
        }
    </section>
}
<span class="eyebrow">Privacy & discovery</span><section class="settings-group"><label class="settings-row toggle-row"><Icon Name="visibility" /><span><strong>Public profile visibility</strong><small>Let visitors discover your profile. Dating intent is never public.</small></span><input type="checkbox" checked="@model.Public" @onchange="Public" disabled="@Busy" /></label><label class="settings-row toggle-row"><Icon Name="favorite_border" /><span><strong>Dating opt-in <span class="badge">Private</span></strong><small>Only other signed-in members who also opt in can see this intention.</small></span><input type="checkbox" checked="@model.LookingFor.Contains("Dating")" @onchange="Dating" disabled="@Busy" /></label><label class="settings-row toggle-row"><Icon Name="event_available" /><span><strong>Default attendee visibility</strong><small>For future attendance choices. Existing event visibility stays as you set it on each event.</small></span><input type="checkbox" checked="@model.DefaultAttendeeVisible" @onchange="Attendee" disabled="@Busy" /></label></section>
<span class="eyebrow">Safety & support</span><section class="settings-group"><details class="settings-details"><summary><Icon Name="block" />Blocked members <span class="muted">@blocked.Count</span></summary>@if (blocked.Count == 0) { <p class="muted small">You haven't blocked anyone.</p> }@foreach (var p in blocked) { <div class="blocked-row"><span>@p.Name</span><button class="secondary small-button" @onclick="() => Unblock(p.Id)">Unblock</button></div> }<small>Unblocking doesn't restore a removed connection.</small></details><a class="settings-row" href="/help"><Icon Name="spa" /><div><strong>Community guidelines</strong></div><Icon Name="chevron_right" /></a><a class="settings-row" href="/privacy"><Icon Name="policy" /><div><strong>Privacy policy</strong></div><Icon Name="chevron_right" /></a></section>
<button class="settings-row signout" disabled="@Busy" @onclick="SignOut"><Icon Name="logout" /><span>Sign out</span><Icon Name="chevron_right" /></button><section class="delete-section"><h3>Delete account</h3><p class="small muted">Permanently delete your profile, connections, saves, attendance and all messages in your conversations, including the other participants' copies. This cannot be undone.</p>@if (!deleting) { <button class="text-button danger" @onclick="() => deleting = true">Delete my account<Icon Name="arrow_forward" /></button> } else { <label for="delete-confirm">Type DELETE to confirm</label><input id="delete-confirm" @bind="confirmation" @bind:event="oninput" /><div class="actions"><button class="danger-button" disabled="@(confirmation != "DELETE" || Busy)" @onclick="Delete">Permanently delete</button><button class="secondary" @onclick="() => deleting = false">Keep my account</button></div> }</section> }</div>
@code {
    ProfileInput? model; List<AdminPerson> blocked = []; bool deleting; string confirmation = ""; string? referralLink;
    protected override async Task OnInitializedAsync() { await base.OnInitializedAsync(); if (Session?.Id != null) await Run(Refresh); }
    protected override async Task Refresh() { model = await Api.Get<ProfileInput>("profile"); blocked = await Api.Get<List<AdminPerson>>("blocked"); }
    Task Public(ChangeEventArgs e) => Update(() => model!.Public = (bool)e.Value!);
    Task Dating(ChangeEventArgs e) => Update(() => model!.LookingFor = (bool)e.Value! ? model.LookingFor.Append("Dating").Distinct().ToArray() : model.LookingFor.Where(x => x != "Dating").ToArray());
    Task Attendee(ChangeEventArgs e) => Update(() => model!.DefaultAttendeeVisible = (bool)e.Value!);
    Task CreateReferral() => Run(async () => { var invite = await Api.Send<ReferralInviteResult>("referrals/invite"); referralLink = Nav.BaseUri.TrimEnd('/') + "/onboarding?ref=" + E(invite.Code); });
    Task Update(Action change) => Act(async () => { change(); try { await Api.Send<Ok>("profile", model); Success = "Your privacy settings are saved."; } finally { await Refresh(); } });
    Task Unblock(Guid id) => Act(async () => { await Api.Send<Ok>($"people/{id}/unblock"); await Refresh(); Success = "Member unblocked. You can choose whether to reconnect."; });
    Task SignOut() => Run(async () => { await Api.Send<Ok>("auth/signout"); await Platform.ClearFirebaseSession(); Nav.NavigateTo("/", true); });
    Task Delete() => Run(async () => { await Api.Send<Ok>("account", new { confirm = "DELETE" }, "DELETE"); Nav.NavigateTo("/", true); });
}

