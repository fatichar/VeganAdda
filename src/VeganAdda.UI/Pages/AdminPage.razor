@page "/admin"
@inherits Screen
<PageTitle>Community administration · VeganAdda</PageTitle>
<span class="eyebrow">Care for the community</span><h1>Community administration</h1><Feedback Error="@Error" Success="@Success" />
@if (Session?.IsAdmin != true) { <Empty Icon="lock" Title="Community team access" Text="This page is available only to authorized administrators." /> }
else if (data != null) {
    <div class="tab-row">@foreach (var t in new[] { "Events", "Members", "Reports" }) { <button class="chip @(tab == t ? "active" : "")" @onclick="() => SwitchTab(t)">@t@if (t == "Members" && data.ProfilesTotal > 0) { <span class="badge" aria-label="Profiles awaiting approval">@data.ProfilesTotal</span> }</button> }</div>
    @if (tab == "Events") {
        <div class="admin-events"><aside class="card"><button @onclick="NewEvent"><Icon Name="add" />Create event</button>@foreach (var item in data.Events) { <button class="admin-event-link secondary" @onclick="() => Edit(item)">@item.Title<span class="badge">@(item.Published ? "Published" : "Draft")</span></button> }</aside>
        @if (edit != null) {
            <form class="form-card" @onsubmit="SaveEvent" @onsubmit:preventDefault><fieldset class="interactive-form" disabled="@(!RendererInfo.IsInteractive)">
                <h2>@(edit.Id == Guid.Empty ? "New gathering" : "Edit gathering")</h2>
                <label for="event-title">Title</label><input id="event-title" required maxlength="150" @bind="edit.Title" @bind:event="oninput" />
                <label for="event-description">Description</label><textarea id="event-description" rows="5" maxlength="4000" @bind="edit.Description" @bind:event="oninput"></textarea>
                <label for="cover">Cover image</label><InputFile id="cover" OnChange="Upload" accept="image/jpeg,image/png,image/webp" />
                @if (edit.Cover != "") { <img class="admin-cover" src="@edit.Cover" alt="Event cover preview" /> }
                <label for="event-city">City</label><input id="event-city" maxlength="80" @bind="edit.City" @bind:event="oninput" />
                <label for="venue">Venue</label><input id="venue" maxlength="200" @bind="edit.Venue" @bind:event="oninput" />
                <label for="organizer">Organizer</label><input id="organizer" maxlength="150" @bind="edit.Organizer" @bind:event="oninput" />
                <label for="zone">IANA time zone</label><input id="zone" required @bind="edit.TimeZone" @bind:event="oninput" placeholder="Asia/Kolkata" />
                <label for="start">Local start date and time</label><input id="start" type="datetime-local" @bind="start" />
                <label for="end">Local end date and time</label><input id="end" type="datetime-local" @bind="end" />
                <label for="registration">Official registration / information URL</label><input id="registration" type="url" @bind="edit.Registration" @bind:event="oninput" placeholder="https://" />
                <label class="check-row"><input type="checkbox" @bind="edit.Featured" />Feature this event</label>
                <label class="check-row"><input type="checkbox" @bind="edit.Published" />Publish · details are verified and image rights confirmed</label>
                <button disabled="@Busy">Save event</button><small>Leave Ekatva as a draft until official details and affiliation wording are confirmed by the owner.</small>
            </fieldset></form>
        }</div>
        <Pagination PageNumber="@eventsPage" PageSize="20" Total="@data.EventsTotal" Busy="@Busy" PageChanged="SetPage" />
    }
    else if (tab == "Members") {
        <div class="admin-member-toolbar">
            <select id="member-approval" aria-label="Filter members by approval" @bind="memberApproval" @bind:after="FilterMembers" disabled="@Busy"><option value="all">All members</option><option value="approved">Approved</option><option value="awaiting-approval">Awaiting approval</option><option value="no-profile">No profile</option></select>
            <p class="small muted">Select a name to view their profile.</p>
        </div>
        @if (data.People.Count == 0) { <Empty Icon="group" Title="No members found" Text="Choose another approval filter." /> }
        <div class="admin-rows">
        @foreach (var p in data.People) {
            <article class="card admin-member" @key="p.Id">
                <div class="admin-row"><div>
                    @if (p.HasProfile) { <button class="admin-member-name" disabled="@Busy" aria-expanded="@(expandedMember == p.Id ? "true" : "false")" aria-controls="member-profile-@p.Id" @onclick="() => ToggleMember(p.Id)">@p.Name<Icon Name="@(expandedMember == p.Id ? "expand_less" : "expand_more")" /></button> }
                    else { <strong>@p.Name</strong> }
                    <small>@(p.Suspended ? "Suspended" : "Active") · @(p.IsVegan == true ? "Vegan" : p.IsVegan == false ? "Not vegan" : "Status missing") · @(p.Public ? "Public" : "Members only") · @(!p.HasProfile ? "No profile" : p.Approved ? "Approved" : "Awaiting approval")@(p.TestProfile ? " · Test profile" : "")@(p.Admin ? " · Admin" : p.Moderator ? " · Moderator" : "")</small>
                </div><div class="actions"><button class="secondary small-button" disabled="@(Busy || p.Id == Session?.Id)" @onclick='() => Moderate(p.Id, p.Admin ? "revoke-admin" : "grant-admin")'>@(p.Admin ? "Revoke admin" : "Appoint admin")</button><button class="secondary small-button" disabled="@Busy" @onclick='() => Moderate(p.Id, p.Moderator ? "revoke-moderator" : "grant-moderator")'>@(p.Moderator ? "Remove moderator" : "Make moderator")</button><button class="secondary small-button" disabled="@(Busy || !p.HasProfile || p.Suspended && !p.Approved)" @onclick='() => Moderate(p.Id, p.Approved ? "revoke-approval" : "approve")'>@(p.Approved ? "Revoke approval" : "Approve")</button><button class="secondary small-button" disabled="@Busy" @onclick='() => Moderate(p.Id, p.TestProfile ? "normal-profile" : "test-profile")'>@(p.TestProfile ? "Mark real" : "Mark test")</button><button class="secondary small-button" disabled="@Busy" @onclick='() => Moderate(p.Id, p.Featured ? "unfeature" : "feature")'>@(p.Featured ? "Unfeature" : "Feature")</button><button class="secondary small-button danger" disabled="@Busy" @onclick='() => Moderate(p.Id, p.Suspended ? "restore" : "suspend")'>@(p.Suspended ? "Restore access" : "Suspend")</button></div></div>
                @if (expandedMember == p.Id && memberProfile != null) {
                    var profile = memberProfile;
                    <div id="member-profile-@p.Id" class="admin-member-details">
                        <h2 class="sr-only">Profile details for @profile.Name</h2>
                        <div class="admin-profile-summary"><Avatar Name="@profile.Name" Photo="@profile.Photo" /><small>@string.Join(", ", new[] { profile.City, profile.State, profile.Country }.Where(x => !string.IsNullOrWhiteSpace(x)))</small></div>
                        @if (profile.VeganVerificationPending) { <p class="notice">Vegan status verification required before approval.</p> }
                        <p class="profile-bio">@(string.IsNullOrWhiteSpace(profile.Bio) ? "No bio provided." : profile.Bio)</p>
                        <p class="small">Interests: @(profile.Interests.Length == 0 ? "None" : string.Join(", ", profile.Interests)) · Looking for: @string.Join(", ", profile.LookingFor)</p>
                        <div class="profile-social-review">@if (profile.Instagram != null) { <a href="@profile.Instagram" target="_blank" rel="noopener noreferrer">Instagram <Icon Name="open_in_new" /></a> }@if (profile.LinkedIn != null) { <a href="@profile.LinkedIn" target="_blank" rel="noopener noreferrer">LinkedIn <Icon Name="open_in_new" /></a> }@if (profile.Website != null) { <a href="@profile.Website" target="_blank" rel="noopener noreferrer">Website <Icon Name="open_in_new" /></a> }</div>
                        <p class="small">@(profile.ReferredBy == null ? "No referral" : $"Referred by {profile.ReferredBy}" + (profile.ReferrerCanRefer ? " · referral access active" : " · referral access inactive"))</p>
                        @if (profile.ReviewNote != null) { <p class="notice">Previous review: @profile.ReviewNote</p> }
                        <label for="review-@p.Id">Note for member if changes are needed</label><textarea id="review-@p.Id" @bind:get="reviewNotes.GetValueOrDefault(p.Id, string.Empty)" @bind:set="value => reviewNotes[p.Id] = value ?? string.Empty" @bind:event="oninput" maxlength="500" rows="2" placeholder="Explain what needs updating"></textarea>
                        <div class="actions"><button class="secondary" disabled="@(Busy || string.IsNullOrWhiteSpace(reviewNotes.GetValueOrDefault(p.Id)))" @onclick="() => ReviewProfile(p.Id, false)">Request changes</button></div>
                    </div>
                }
            </article>
        }</div>
        <Pagination PageNumber="@membersPage" PageSize="20" Total="@data.MembersTotal" Busy="@Busy" PageChanged="SetPage" />
    }
    else {
        @if (data.Reports.Count == 0) { <Empty Icon="shield" Title="No reports to review" Text="Member reports will appear here." /> }
        @foreach (var report in data.Reports) {
            <article class="card"><div class="section-heading"><h3>@report.Subject</h3><span class="badge">@(report.Resolved ? "Resolved" : "Needs review")</span></div><p>@report.Reason</p><small>@Date(report.Created)</small>
            @if (!report.Resolved) { <div class="actions"><button class="secondary" @onclick='() => Moderate(report.Id, "resolve")'>Mark reviewed</button>@if (report.SubjectId != Guid.Empty) { <button class="danger-button" @onclick='() => Moderate(report.SubjectId, "suspend")'>Suspend member</button> }</div> }</article>
        }
        <Pagination PageNumber="@reportsPage" PageSize="20" Total="@data.ReportsTotal" Busy="@Busy" PageChanged="SetPage" />
    }
}
@code {
    AdminData? data; EventInput? edit; string tab = "Events", memberApproval = "all"; int eventsPage = 1, membersPage = 1, reportsPage = 1; Guid? expandedMember; ProfileReview? memberProfile; DateTime? start, end; Dictionary<Guid, string> reviewNotes = [];
    protected override async Task OnInitializedAsync() { await base.OnInitializedAsync(); if (Session?.IsAdmin == true) await Run(Refresh); }
    protected override async Task Refresh() {
        data = await Api.Get<AdminData>($"admin?approval={E(memberApproval)}&section={E(tab)}&page={CurrentPage}");
        if (tab == "Events") eventsPage = data.PageNumber; else if (tab == "Reports") reportsPage = data.PageNumber; else membersPage = data.PageNumber;
        if (expandedMember is { } id && data.People.Any(p => p.Id == id && p.HasProfile)) memberProfile = await Api.Get<ProfileReview>($"admin/members/{id}");
        else { expandedMember = null; memberProfile = null; }
    }
    int CurrentPage => tab == "Events" ? eventsPage : tab == "Reports" ? reportsPage : membersPage;
    Task SwitchTab(string value) { tab = value; return Run(Refresh); }
    Task SetPage(int value) { if (tab == "Events") eventsPage = value; else if (tab == "Reports") reportsPage = value; else membersPage = value; return Run(Refresh); }
    Task FilterMembers() { membersPage = 1; return Run(Refresh); }
    Task ToggleMember(Guid id) => Run(async () => {
        if (expandedMember == id) { expandedMember = null; memberProfile = null; }
        else { var profile = await Api.Get<ProfileReview>($"admin/members/{id}"); memberProfile = profile; expandedMember = id; }
    });
    void NewEvent() { edit = new(); start = end = null; }
    void Edit(EventInput item) { edit = JsonSerializer.Deserialize<EventInput>(JsonSerializer.Serialize(item, Wire.Json), Wire.Json); var zone = TimeZoneInfo.FindSystemTimeZoneById(item.TimeZone); start = item.Start.HasValue ? TimeZoneInfo.ConvertTime(item.Start.Value, zone).DateTime : null; end = item.End.HasValue ? TimeZoneInfo.ConvertTime(item.End.Value, zone).DateTime : null; }
    Task SaveEvent() => Run(async () => { try { var zone = TimeZoneInfo.FindSystemTimeZoneById(edit!.TimeZone); edit.Start = start.HasValue ? new DateTimeOffset(TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(start.Value, DateTimeKind.Unspecified), zone)) : null; edit.End = end.HasValue ? new DateTimeOffset(TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(end.Value, DateTimeKind.Unspecified), zone)) : null; } catch { throw new ApiException(400, "Check the time zone and local event times."); } await Api.Send<Ok>("admin/events", edit); await Refresh(); Success = "Event saved."; });
    Task Moderate(Guid id, string action) => Run(async () => { await Api.Send<Ok>("admin/moderate", new ModerateInput(id, action)); await Refresh(); Success = action == "approve" ? "Profile approved." : action == "revoke-approval" ? "Profile approval revoked." : "Community record updated."; });
    Task ReviewProfile(Guid id, bool approve) => Run(async () => { var note = reviewNotes.GetValueOrDefault(id); await Api.Send<Ok>("admin/profile-review", new ProfileReviewInput(id, approve, note)); reviewNotes.Remove(id); await Refresh(); Success = approve ? "Profile approved." : "Changes requested."; });
    Task Upload(InputFileChangeEventArgs e) => Run(async () => { if (e.File.Size > 2 * 1024 * 1024) throw new ApiException(400, "Choose an image smaller than 2 MB."); await using var stream = e.File.OpenReadStream(2 * 1024 * 1024); edit!.Cover = await Platform.Upload(stream, e.File.Name, e.File.ContentType); });
}



