@page "/events/{Id:guid}"
@inherits Screen
<PageTitle>@(ev?.Title ?? "Event") · VeganAdda</PageTitle>
<a class="back-link" href="/events"><Icon Name="arrow_back" />All events</a><Feedback Error="@Error" Success="@Success" />
@if (ev != null) { <section class="event-detail-hero">@if (ev.Cover != "") { <img src="@ev.Cover" alt="" /> }<div class="event-detail-title"><span class="badge">@(ev.Demo ? "Fictional sample event · development only" : "Community event")</span><h1>@ev.Title</h1><div class="event-meta"><span><Icon Name="calendar_today" />@Date(ev.Start, ev.TimeZone) – @Date(ev.End, ev.TimeZone)</span><span><Icon Name="location_on" />@ev.City · @ev.Venue</span></div><p>@ev.TimeZone · Organized by @ev.Organizer</p></div></section><div class="event-detail-grid"><section class="card"><h2>A little more together.</h2><p class="event-description">@ev.Description</p><div class="attendance-box"><button @onclick="Attend" disabled="@Busy"><Icon Name="@(ev.Attending ? "check_circle" : "event_available")" />@(ev.Attending ? "I'm attending · undo" : "I'm attending")</button><button class="secondary" @onclick="Save" disabled="@Busy"><Icon Name="@(ev.Saved ? "bookmark" : "bookmark_border")" />@(ev.Saved ? "Saved" : "Save for later")</button></div><p class="small muted">Attendance here is a community signal. It is not a ticket purchase or official organizer registration.</p>
@if (ev.Registration != null) { <a class="external-link" href="@ev.Registration" target="_blank" rel="noopener noreferrer nofollow">Official registration / event information<Icon Name="north_east" /></a> }
@if (ev.Attending) { <label class="check-row"><input type="checkbox" checked="@ev.AttendeeVisible" @onchange="Visibility" /><span>Show me in this event's attendee list<small>Visible only to signed-in members. Turning this off also checks you out.</small></span></label> }
@if (EventRunning && ev.Attending)
{
    <div class="attendance-box"><button class="secondary" @onclick="CheckIn" disabled="@(Busy || !ev.AttendeeVisible)"><Icon Name="@(IsCheckedIn ? "logout" : "login")" />@(IsCheckedIn ? "Check out" : "Check in")</button></div>
    <p class="small muted">@(IsCheckedIn ? $"You're checked in until {Date(ev.CheckedInUntil, ev.TimeZone)}. Check out when you leave." : "Check in to let other signed-in members know you're at the event. Enable attendee visibility first. Check-in expires after 4 hours or when the event ends.")</p>
}
else if (ev.Attending && ev.Start > DateTimeOffset.UtcNow) { <p class="small muted">Check-in opens when the event starts.</p> }
</section><aside class="card attendee-card"><h2>Meet fellow attendees</h2><a class="button secondary full" href="/?event=@Id">Browse attendees</a><a class="text-button full" href="/?event=@Id&checkedIn=true">See checked-in people<Icon Name="arrow_forward" /></a><p class="small muted">Only signed-in members can see people who choose to appear. Check-ins are self-reported.</p></aside></div> }
@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery] public string? Action { get; set; }
    EventCard? ev; bool actionDone;
    bool EventRunning => ev?.Start <= DateTimeOffset.UtcNow && ev?.End > DateTimeOffset.UtcNow;
    bool IsCheckedIn => ev?.CheckedInUntil > DateTimeOffset.UtcNow && EventRunning;
    protected override async Task OnInitializedAsync() { await base.OnInitializedAsync(); }
    protected override Task OnParametersSetAsync() => Run(Refresh);
    protected override async Task Refresh() { ev = await Api.Get<EventCard>("events/" + Id); }
    protected override async Task OnAfterRenderAsync(bool first) { await base.OnAfterRenderAsync(first); if (!actionDone && Action != null && ev != null && Session?.Id != null) { actionDone = true; if (!ReadyForAction(Current)) return; if (Action == "save" && !ev.Saved) await Save(); else if (Action == "attend" && !ev.Attending) await Attend(); Nav.NavigateTo("/events/" + Id, replace: true); StateHasChanged(); } }
    async Task Attend() { if (!ReadyForAction($"/events/{Id}?action=attend")) return; await Act(async () => { var visibility = ev!.Attending ? false : (await Api.Get<ProfileInput>("profile")).DefaultAttendeeVisible; await Api.Send<Ok>($"events/{Id}/attendance", new AttendanceInput(!ev.Attending, visibility)); await Refresh(); Success = ev!.Attending ? "You're attending. Check the organizer's registration requirements separately." : "Your attendance has been removed."; }); }
    async Task Save() { if (!ReadyForAction($"/events/{Id}?action=save")) return; await Act(async () => { await Api.Send<Ok>($"events/{Id}/save"); await Refresh(); Success = "Your saved events are updated."; }); }
    Task Visibility(ChangeEventArgs e) => Act(async () => { await Api.Send<Ok>($"events/{Id}/attendance", new AttendanceInput(true, (bool)e.Value!)); await Refresh(); Success = "Your attendee visibility is updated."; });
    Task CheckIn() => Act(async () => { var checkingIn = !IsCheckedIn; await Api.Send<Ok>($"events/{Id}/check-in", new CheckInInput(checkingIn)); await Refresh(); Success = checkingIn ? "You're checked in. Meet people through Discover." : "You're checked out. You're still marked as attending."; });
}


