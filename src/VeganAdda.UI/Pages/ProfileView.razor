@page "/people/{Id:guid}"
@inherits Screen
<PageTitle>@(person?.Name ?? "Member") · VeganAdda</PageTitle>
<a class="back-link" href="/"><Icon Name="arrow_back" />Back to discovery</a><Feedback Error="@Error" Success="@Success" />
@if (person?.IsVegan == false) { <p class="notice" role="status">This member is not vegan.</p> }
else if (person?.VeganStatusUnverified == true) { <p class="notice" role="status">This member's vegan status is unverified.</p> }
@if (person != null) { <div class="profile-layout"><div><div class="profile-banner">@if (person.Demo) { <span class="badge">Sample profile</span> }<Icon Name="eco" /></div><section class="profile-main card"><Avatar Name="@person.Name" Photo="@person.Photo" VeganVerified="@person.VeganVerified" Size="large" /><div class="profile-actions">@if (person.Relationship != "self") { <button @onclick="Connect">@(person.Relationship == "connected" ? "Send a message" : person.Relationship == "sent" ? "Request sent" : person.Relationship == "received" ? "View request" : "Connect")<Icon Name="@(person.Relationship == "connected" ? "chat_bubble" : "person_add")" /></button><button class="icon-button secondary" aria-label="Save profile" @onclick="Save"><Icon Name="@(person.Saved ? "bookmark" : "bookmark_border")" /></button> }</div><h1>@person.Name@if (person.Age.HasValue) { <text>, @person.Age</text> }</h1><span class="location"><Icon Name="location_on" />@string.Join(", ", new[] { person.City, person.State, person.Country }.Where(x => !string.IsNullOrWhiteSpace(x)))</span>@if (person.IsBirthday) { <p class="birthday-highlight"><Icon Name="cake" />Birthday today</p> }@if (!string.IsNullOrWhiteSpace(person.Profession)) { <p class="profile-profession">@person.Profession</p> }<p class="profile-bio">@person.Bio</p><h3>Interests</h3><div class="tags">@foreach (var tag in person.Interests) { <span>#@tag.Replace(" ", "")</span> }</div></section></div><aside>@if (person.Relationship == "self") { <VerificationPanel /> }<section class="card"><h3>Looking for</h3><div class="tags intentions">@foreach (var intent in person.LookingFor) { <span>@intent</span> }</div></section>@if (person.Instagram != null || person.LinkedIn != null || person.Website != null) { <section class="card"><h3>Links</h3>@if (person.Website != null) { <a class="external-link" href="@person.Website" rel="noopener noreferrer nofollow" target="_blank">Website<Icon Name="north_east" /></a> }@if (person.Instagram != null) { <a class="external-link" href="@person.Instagram" rel="noopener noreferrer nofollow" target="_blank">Instagram<Icon Name="north_east" /></a> }@if (person.LinkedIn != null) { <a class="external-link" href="@person.LinkedIn" rel="noopener noreferrer nofollow" target="_blank">LinkedIn<Icon Name="north_east" /></a> }<small>Social links are not identity verification.</small></section> }
@if (Session?.Id != null && person.Relationship != "self") { <section class="card" id="safety"><h3>Safety</h3><details><summary>Report this member</summary><label for="reason">What happened?</label><textarea id="reason" maxlength="1000" rows="3" @bind="reason" @bind:event="oninput"></textarea><button class="secondary" @onclick="Report" disabled="@Busy">Submit report</button></details><button class="text-button danger" @onclick="() => confirmBlock = true"><Icon Name="block" />Block member</button>@if (confirmBlock) { <p class="small">Blocking hides your profiles from each other and pauses messaging until unblocked. Existing history remains.</p><button class="danger-button" @onclick="Block" disabled="@Busy">Confirm block</button> }</section> }</aside></div><ConnectDialog Person="connecting" Closed="() => connecting = null" Sent="Sent" /> }
else if (!Busy && Error == "") { <Empty Title="This profile isn't available" Text="It may be private or no longer part of the community." /> }
@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery] public string? Action { get; set; }
    Person? person, connecting; string reason = ""; bool actionDone, confirmBlock;
    protected override async Task OnInitializedAsync() { await base.OnInitializedAsync(); }
    protected override Task OnParametersSetAsync() => Run(Refresh);
    protected override async Task Refresh() => person = await Profiles.GetPerson(Id);
    protected override async Task OnAfterRenderAsync(bool first) { await base.OnAfterRenderAsync(first); if (!actionDone && Action != null && person != null && Session?.Id != null) { actionDone = true; if (!ReadyForAction(Current)) return; if (Action == "connect") await Connect(); else if (Action == "save" && !person.Saved) await Save(); Nav.NavigateTo("/people/" + Id, replace: true); StateHasChanged(); } }
    Task Connect() { if (Session?.Id == null) Platform.SignIn($"/people/{Id}?action=connect"); else if (!Session.BasicProfileComplete) Nav.NavigateTo($"/onboarding?returnUrl={E($"/people/{Id}?action=connect")}"); else if (person!.Relationship == "connected") Nav.NavigateTo("/messages/" + Pair()); else if (person.Relationship is "sent" or "received") Nav.NavigateTo("/messages/" + Pair()); else connecting = person; return Task.CompletedTask; }
    string Pair() => string.CompareOrdinal(Session!.Id.ToString(), Id.ToString()) < 0 ? $"{Session.Id:N}_{Id:N}" : $"{Id:N}_{Session.Id:N}";
    async Task Save() { if (!ReadyForAction($"/people/{Id}?action=save")) return; await Act(async () => { await Api.Send<Ok>($"people/{Id}/save"); await Refresh(); Success = person!.Saved ? "Saved to your people." : "Removed from saved people."; }); }
    Task Sent() => Run(async () => { await Refresh(); Success = "Connection request sent."; });
    Task Report() => Act(async () => { await Api.Send<Ok>($"people/{Id}/report", new ReportInput(Id, reason)); reason = ""; Success = "Thank you. The community team will review your report."; });
    Task Block() => Act(async () => { await Api.Send<Ok>($"people/{Id}/block"); Nav.NavigateTo("/settings"); });
}
