@page "/messages"
@page "/messages/{Key}"
@inherits Screen
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject IMessagingApi MessagingApi
<PageTitle>Messages · VeganAdda</PageTitle>
<h1 class="sr-only">Messages</h1>
<Feedback Error="@Error" Success="@Success" />
@if (Session?.Id == null)
{
    <Empty Icon="chat_bubble" Title="Your messages" Text="Sign in to see chats and connection requests."><a class="button" href="/signin?returnUrl=%2Fmessages">Sign in</a></Empty>
}
else
{
        <div class="chat-layout @(Key != null ? "has-conversation" : "")">
            <aside class="conversation-list" aria-label="Messages">
                @if (conversations.Count == 0 && Requests.Count == 0)
                {
                    <Empty Icon="chat_bubble" Title="No messages yet" Text="Connect with someone to start chatting."><a href="/" class="button secondary">Discover people</a></Empty>
                }
                @foreach (var request in VisibleRequests)
                {
                    <a class="conversation conversation-request @(request.Incoming ? "incoming-request" : "sent-request") @(request.Key == Key ? "selected" : "")" href="/messages/@request.Key" aria-current="@(request.Key == Key ? "page" : null)" @key="request.Key">
                        <Avatar Name="@request.Person.Name" Photo="@request.Person.Photo" VeganVerified="@request.Person.VeganVerified" />
                        <div><strong>@request.Person.Name</strong><span class="request-label">@(request.Incoming ? "Connection request" : "Request sent")@(request.Person.IsVegan == false ? " · Not vegan" : request.Person.VeganStatusUnverified ? " · Vegan status unverified" : request.Person.IsVegan is null ? " · Vegan status not set" : "")</span>@if (request.Introduction != "") { <p>@request.Introduction</p> }</div>
                        <Icon Name="@(request.Incoming ? "person_add" : "schedule")" />
                    </a>
                }
                <Pagination PageNumber="@requestPage" PageSize="10" Total="@requestTotal" Busy="@Busy" PageChanged="SetRequestPage" />
                @foreach (var c in VisibleChats)
                {
                    <a class="conversation @(c.Key == Key ? "selected" : "") @(c.Unread > 0 ? "has-unread" : "")" href="/messages/@c.Key" @key="c.Key">
                        <Avatar Name="@c.Name" Photo="@c.Photo" VeganVerified="@c.VeganVerified" /><div class="conversation-copy"><div class="conversation-top"><strong>@c.Name</strong><small title="@Date(c.Updated)">@InboxTimestamp.Format(c.Updated, DateTimeOffset.UtcNow)</small></div><div class="conversation-preview"><p>@c.Latest</p>@if (c.Unread > 0) { <span class="count" aria-label="@($"{c.Unread} unread messages")">@c.Unread</span> }</div></div>
                    </a>
                }
                <Pagination PageNumber="@chatPage" PageSize="10" Total="@chatTotal" Busy="@Busy" PageChanged="SetChatPage" />
            </aside>
            <section class="chat-panel" aria-label="Conversation">
                @if (Key == null) { <Empty Icon="forum" Title="Choose a chat" Text="Select someone to start chatting." /> }
                else if (messagePage == null) { <p class="loading" role="status">Loading conversation…</p> }
                else
                {
                    <div class="chat-header">
                        <a class="icon-button mobile-back" href="/messages" aria-label="Back to chats"><Icon Name="arrow_back" /></a>
                        <Avatar Name="@(SelectedRequest?.Person.Name ?? Selected?.Name ?? "Conversation")" Photo="@(SelectedRequest?.Person.Photo ?? Selected?.Photo ?? "")" VeganVerified="@(SelectedRequest?.Person.VeganVerified ?? Selected?.VeganVerified ?? false)" />
                        <div class="chat-heading"><h2>@(SelectedRequest?.Person.Name ?? Selected?.Name ?? "Conversation")</h2><small>@(Selected?.BlockedByMe == true ? "Member blocked" : SelectedRequest is { } currentRequest ? (currentRequest.Incoming ? "Connection request" : "Request sent") : messagePage.CanMessage ? "Connected" : "Messaging unavailable · history remains available")</small></div>
                        @if (SelectedPersonId is { } personId)
                        {
                            <div class="chat-menu" @onkeydown="MenuKeyDown">
                                <button class="icon-button" aria-label="Chat options" aria-expanded="@menuOpen" aria-controls="chat-options" @onclick="() => menuOpen = !menuOpen"><Icon Name="more_vert" /></button>
                                @if (menuOpen)
                                {
                                <div class="chat-menu-items" id="chat-options">
                                    @if (Selected?.BlockedByMe == true)
                                    {
                                        <button class="text-button" disabled="@Busy" @onclick="Unblock">Unblock member</button>
                                    }
                                    else
                                    {
                                    <a href="/people/@personId">View profile</a>
                                    <a href="/people/@personId#safety">Report member</a>
                                    @if (messagePage.CanMessage) { <button class="text-button danger" @onclick='() => Ask("remove")'>Remove connection</button> }
                                    <button class="text-button danger" @onclick='() => Ask("block")'>Block member</button>
                                    }
                                </div>
                                }
                            </div>
                        }
                    </div>
                    @if (confirmAction != "")
                    {
                        <div class="notice chat-confirm" role="alert">
                            <p>@(confirmAction == "block" ? "Block this member? Your profiles will be hidden from each other and messaging will pause until unblocked. Existing history remains." : "Remove this connection? Messaging will close. Both of you can still view existing history.")</p>
                            <button class="danger-button" disabled="@Busy" @onclick="ConfirmAction">Confirm @(confirmAction == "block" ? "block" : "removal")</button>
                            <button class="text-button" @onclick='() => confirmAction = ""'>Cancel</button>
                        </div>
                    }
                    <div class="message-history" aria-live="polite" @ref="historyElement">
                        @if (SelectedPersonId is { } referralPersonId) { <ReferralRequestCard @key="referralPersonId" PersonId="@referralPersonId" /> }
                        @if (SelectedRequest is { } introduction)
                        {
                            <div class="request-introduction">
                                @if (introduction.Introduction != "") { <p>@introduction.Introduction</p> }
                                else { <p>@(introduction.Incoming ? $"{introduction.Person.Name} would like to connect." : $"Your connection request to {introduction.Person.Name} is pending.")</p> }
                                @if (introduction.Incoming && introduction.Person.IsVegan == false) { <p class="notice" role="status"><strong>Not vegan.</strong> Review this member's status before accepting their request.</p> }
                                else if (introduction.Incoming && introduction.Person.VeganStatusUnverified) { <p class="notice" role="status"><strong>Vegan status is unverified.</strong> Consider this before accepting the request.</p> }
                                else if (introduction.Incoming && introduction.Person.IsVegan is null) { <p class="notice" role="status"><strong>Vegan status not provided.</strong> Review this member's profile before accepting their request.</p> }
                            </div>
                        }
                        @if (hasOlder) { <button class="secondary older" @onclick="Older" disabled="@Busy">Load earlier messages</button> }
                        @foreach (var message in history)
                        {
                            <div class="message-row @(message.SenderId == Session.Id ? "mine" : "")" @key="message.Id"><div class="message-bubble">@message.Text</div><small>@Date(message.SentAt) @(message.SenderId == Session.Id ? "· Sent" : "")</small></div>
                        }
                        @foreach (var item in pending.Values.Where(p => p.Key == Key).ToList())
                        {
                            <div class="message-row mine"><div class="message-bubble">@item.Text</div><small>@(item.Failed ? "Failed to send" : "Sending…")</small>@if (item.Failed) { <button class="text-button" @onclick="() => SendPending(item)">Retry message</button> }</div>
                        }
                    </div>
                    @if (SelectedRequest is { } selectedRequest)
                    {
                        <div class="request-actions">
                            <div class="actions">
                                @if (selectedRequest.Incoming)
                                {
                                    <button disabled="@Busy" @onclick='() => ConnectionAction(selectedRequest, "accept")'>Accept</button>
                                    <button class="secondary" disabled="@Busy" @onclick='() => ConnectionAction(selectedRequest, "decline")'>Decline</button>
                                }
                                else { <button class="secondary" disabled="@Busy" @onclick='() => ConnectionAction(selectedRequest, "cancel")'>Cancel request</button> }
                                <a class="text-button" href="/people/@selectedRequest.Person.Id">View profile</a>
                            </div>
                        </div>
                    }
                    else if (messagePage.CanMessage)
                    {
                        <MessageComposer @key="Key" Sending="@sending" Submitted="SendText" />
                    }
                    else if (Selected?.BlockedByMe == true)
                    {
                        <div class="notice"><p>You blocked this member. Unblock them to resume an existing connection.</p><button class="secondary" disabled="@Busy" @onclick="Unblock">Unblock member</button></div>
                    }
                    else if (Selected?.CanReconnect == true)
                    {
                        <div class="notice"><p>This connection was removed. Send a new connection request to chat again.</p><button class="secondary" disabled="@Busy" @onclick="Reconnect">Reconnect</button></div>
                    }
                    else { <div class="notice">Messaging is unavailable. Existing messages are available to both participants until an account is deleted.</div> }
                }
            </section>
        </div>
}
@code {
    protected override ChangeArea ChangeInterests => ChangeArea.Messaging | ChangeArea.Connections | ChangeArea.Profiles;
    [Parameter] public string? Key { get; set; }
    List<Conversation> conversations = [];
    List<ConnectionItem> connections = [];
    List<Message> history = [];
    MessagePage? messagePage;
    string loadedKey = "", confirmAction = "";
    bool sending, refreshing, refreshAgain, hasOlder, menuOpen;
    int requestPage = 1, chatPage = 1;
    bool scrollToLatest;
    long latestFetchedMessageId;
    ElementReference historyElement;
    readonly CancellationTokenSource stop = new();
    readonly Dictionary<Guid, PendingMessage> pending = new();
    Conversation? Selected => selectedConversation;
    Conversation? selectedConversation;
    ConnectionItem? selectedRequest;
    int requestTotal, chatTotal;
    ConnectionItem? SelectedRequest => selectedRequest;
    Guid? SelectedPersonId => SelectedRequest?.Person.Id ?? Selected?.PersonId;
    List<ConnectionItem> Requests => connections.Where(c => c.State == "pending").OrderByDescending(c => c.Incoming).ThenByDescending(c => c.Updated).ToList();
    IEnumerable<Conversation> Chats => conversations;
    IEnumerable<ConnectionItem> VisibleRequests => Requests;
    IEnumerable<Conversation> VisibleChats => Chats;
    class PendingMessage(Guid id, string text, string key) { public Guid Id = id; public string Text = text; public string Key = key; public bool Failed; }
    protected override async Task OnParametersSetAsync()
    {
        if (Key != loadedKey) { history.Clear(); latestFetchedMessageId = 0; messagePage = null; hasOlder = false; confirmAction = ""; menuOpen = false; loadedKey = Key ?? ""; }
        if (Session?.Id != null) await Run(Refresh);
    }
    protected override async Task OnAfterRenderAsync(bool first)
    {
        await base.OnAfterRenderAsync(first);
        if (first) _ = Poll();
        if (scrollToLatest && messagePage != null)
        {
            scrollToLatest = false;
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/VeganAdda.UI/messages.js");
            await module.InvokeVoidAsync("scrollToLatest", historyElement);
        }
    }
    async Task Poll()
    {
        try { using var timer = new PeriodicTimer(TimeSpan.FromMinutes(2)); while (await timer.WaitForNextTickAsync(stop.Token)) { if (await Platform.IsVisible()) await InvokeAsync(async () => { await Run(Refresh); await Platform.StartRealtime(); StateHasChanged(); }); } }
        catch (OperationCanceledException) { }
    }
    protected override async Task Refresh()
    {
        if (Session?.Id == null) return;
        if (refreshing) { refreshAgain = true; return; }
        refreshing = true; refreshAgain = false;
        try
        {
            var inbox = await MessagingApi.GetInbox(chatPage, requestPage, Key);
            conversations = inbox.Chats.Items; connections = inbox.Requests.Items;
            chatPage = inbox.Chats.PageNumber; requestPage = inbox.Requests.PageNumber;
            chatTotal = inbox.Chats.Total; requestTotal = inbox.Requests.Total;
            selectedConversation = inbox.Selected; selectedRequest = inbox.SelectedRequest;
            if (Key != null)
            {
                var key = Key; MessagePage result;
                if (history.Count == 0)
                {
                    result = await Api.Get<MessagePage>($"conversations/{key}/messages");
                    if (Key != key) return;
                    hasOlder = result.HasOlder; history = result.Items; scrollToLatest = true;
                    latestFetchedMessageId = history.LastOrDefault()?.Id ?? 0;
                }
                else
                {
                    do
                    {
                        result = await Api.Get<MessagePage>($"conversations/{key}/messages?after={latestFetchedMessageId}");
                        if (Key != key) return;
                        var previousCount = history.Count;
                        history = history.Concat(result.Items).DistinctBy(m => m.Id).OrderBy(m => m.Id).ToList();
                        if (result.Items.Count > 0) latestFetchedMessageId = result.Items[^1].Id;
                        if (history.Count > previousCount) scrollToLatest = true;
                    } while (result.HasNewer);
                }
                if (Key != key) return;
                messagePage = result;
                foreach (var m in history) pending.Remove(m.ClientId);
                if (history.Count > 0 && Selected?.Unread > 0)
                {
                    await Api.Send<Ok>($"conversations/{key}/read", new ReadInput(history[^1].Id));
                    var updated = await MessagingApi.GetInbox(chatPage, requestPage, Key);
                    conversations = updated.Chats.Items; selectedConversation = updated.Selected;
                }
            }
        }
        finally { refreshing = false; if (refreshAgain) await Refresh(); }
    }
    Task SetRequestPage(int value) => Run(async () => { requestPage = value; await Refresh(); });
    Task SetChatPage(int value) => Run(async () => { chatPage = value; await Refresh(); });
    Task Older() => Run(async () =>
    {
        var key = Key;
        var older = await Api.Get<MessagePage>($"conversations/{key}/messages?before={history.FirstOrDefault()?.Id ?? long.MaxValue}");
        if (Key != key) return;
        history = older.Items.Concat(history).DistinctBy(m => m.Id).OrderBy(m => m.Id).ToList(); hasOlder = older.HasOlder; messagePage = older;
    });
    async Task SendText(string text)
    {
        if (sending || string.IsNullOrWhiteSpace(text) || Key == null) return;
        var item = new PendingMessage(Guid.NewGuid(), text.Trim(), Key); pending[item.Id] = item; await SendPending(item);
    }
    async Task SendPending(PendingMessage item)
    {
        if (sending) return; item.Failed = false; sending = true; scrollToLatest = true; StateHasChanged();
        try
        {
            var result = await Api.Send<Message>($"conversations/{item.Key}/messages", new MessageInput(item.Id, item.Text)); pending.Remove(item.Id);
            if (item.Key == Key) { history = history.Append(result).DistinctBy(m => m.Id).OrderBy(m => m.Id).ToList(); scrollToLatest = true; }
            await Refresh(); Error = "";
        }
        catch (Exception e) { item.Failed = true; Error = e is ApiException ? e.Message : "Message couldn't be sent. Retry when your connection returns."; }
        finally { sending = false; }
    }
    Task ConnectionAction(ConnectionItem item, string action) => Act(async () =>
    {
        await Api.Send<Ok>("connections/" + action, new ConnectionInput(item.Person.Id)); await Refresh();
        if (action == "accept") Nav.NavigateTo("/messages/" + item.Key);
        else if (Key == item.Key) Nav.NavigateTo("/messages");
    });
    void Ask(string action) { menuOpen = false; confirmAction = action; }
    Task Unblock() => Act(async () =>
    {
        if (Selected is not { BlockedByMe: true, PersonId: { } id }) return;
        await Api.Send<Ok>($"people/{id}/unblock"); menuOpen = false; await Refresh();
    });
    Task Reconnect() => Act(async () =>
    {
        if (Selected is not { CanReconnect: true, PersonId: { } id }) return;
        await Api.Send<Ok>("connections", new ConnectionInput(id)); await Refresh();
    });
    void MenuKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") menuOpen = false; }
    Task ConfirmAction() => Act(async () =>
    {
        if (SelectedPersonId is not { } id) return;
        if (confirmAction == "block") await Api.Send<Ok>($"people/{id}/block");
        else await Api.Send<Ok>("connections/remove", new ConnectionInput(id));
        confirmAction = ""; await Refresh();
    });
    public override void Dispose() { stop.Cancel(); stop.Dispose(); base.Dispose(); }
}
