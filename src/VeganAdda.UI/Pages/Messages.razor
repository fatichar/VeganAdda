@page "/messages"
@page "/messages/{Key}"
@inherits Screen
<PageTitle>Messages · VeganAdda</PageTitle>
<h1 class="sr-only">Messages</h1>
<Feedback Error="@Error" Success="@Success" />
@if (Session?.Id == null)
{
    <Empty Icon="chat_bubble" Title="Your messages" Text="Sign in to see chats and connection requests."><a class="button" href="/signin?returnUrl=%2Fmessages">Sign in</a></Empty>
}
else
{
        <div class="chat-layout @(Key != null ? "has-conversation" : "")">
            <aside class="conversation-list" aria-label="Messages">
                @if (conversations.Count == 0 && Requests.Count == 0)
                {
                    <Empty Icon="chat_bubble" Title="No messages yet" Text="Connect with someone to start chatting."><a href="/" class="button secondary">Discover people</a></Empty>
                }
                @foreach (var request in Requests)
                {
                    <a class="conversation conversation-request @(request.Incoming ? "incoming-request" : "sent-request") @(request.Key == Key ? "selected" : "")" href="/messages/@request.Key" aria-current="@(request.Key == Key ? "page" : null)" @key="request.Key">
                        <Avatar Name="@request.Person.Name" Photo="@request.Person.Photo" />
                        <div><strong>@request.Person.Name</strong><span class="request-label">@(request.Incoming ? "Connection request" : "Request sent")</span>@if (request.Introduction != "") { <p>@request.Introduction</p> }</div>
                        <Icon Name="@(request.Incoming ? "person_add" : "schedule")" />
                    </a>
                }
                @foreach (var c in Chats)
                {
                    <a class="conversation @(c.Key == Key ? "selected" : "") @(c.Unread > 0 ? "has-unread" : "")" href="/messages/@c.Key" @key="c.Key">
                        <Avatar Name="@c.Name" Photo="@c.Photo" /><div><strong>@c.Name</strong><p>@c.Latest</p><small>@Date(c.Updated)</small></div>
                        @if (c.Unread > 0) { <span class="count" aria-label="@($"{c.Unread} unread messages")">@c.Unread</span> }
                    </a>
                }
            </aside>
            <section class="chat-panel" aria-label="Conversation">
                @if (Key == null) { <Empty Icon="forum" Title="Choose a chat" Text="Select someone to start chatting." /> }
                else if (messagePage == null) { <p class="loading" role="status">Loading conversation…</p> }
                else
                {
                    <div class="chat-header">
                        <a class="icon-button mobile-back" href="/messages" aria-label="Back to chats"><Icon Name="arrow_back" /></a>
                        <Avatar Name="@(SelectedRequest?.Person.Name ?? Selected?.Name ?? "Conversation")" Photo="@(SelectedRequest?.Person.Photo ?? Selected?.Photo ?? "")" />
                        <div class="chat-heading"><h2>@(SelectedRequest?.Person.Name ?? Selected?.Name ?? "Conversation")</h2><small>@(SelectedRequest is { } currentRequest ? (currentRequest.Incoming ? "Connection request" : "Request sent") : messagePage.CanMessage ? "Connected" : "Messaging is closed · history remains available")</small></div>
                        @if (SelectedPersonId is { } personId)
                        {
                            <div class="chat-menu" @onkeydown="MenuKeyDown">
                                <button class="icon-button" aria-label="Chat options" aria-expanded="@menuOpen" aria-controls="chat-options" @onclick="() => menuOpen = !menuOpen"><Icon Name="more_vert" /></button>
                                @if (menuOpen)
                                {
                                <div class="chat-menu-items" id="chat-options">
                                    <a href="/people/@personId">View profile</a>
                                    <a href="/people/@personId#safety">Report member</a>
                                    @if (messagePage.CanMessage) { <button class="text-button danger" @onclick='() => Ask("remove")'>Remove connection</button> }
                                    <button class="text-button danger" @onclick='() => Ask("block")'>Block member</button>
                                </div>
                                }
                            </div>
                        }
                    </div>
                    @if (confirmAction != "")
                    {
                        <div class="notice chat-confirm" role="alert">
                            <p>@(confirmAction == "block" ? "Block this member? Your profiles will be hidden from each other and messaging will close. Existing history remains." : "Remove this connection? Messaging will close. Both of you can still view existing history.")</p>
                            <button class="danger-button" disabled="@Busy" @onclick="ConfirmAction">Confirm @(confirmAction == "block" ? "block" : "removal")</button>
                            <button class="text-button" @onclick='() => confirmAction = ""'>Cancel</button>
                        </div>
                    }
                    <div class="message-history" aria-live="polite">
                        @if (SelectedRequest is { } introduction)
                        {
                            <div class="request-introduction">
                                @if (introduction.Introduction != "") { <p>@introduction.Introduction</p> }
                                else { <p>@(introduction.Incoming ? $"{introduction.Person.Name} would like to connect." : $"Your connection request to {introduction.Person.Name} is pending.")</p> }
                            </div>
                        }
                        @if (hasOlder) { <button class="secondary older" @onclick="Older" disabled="@Busy">Load earlier messages</button> }
                        @foreach (var message in history)
                        {
                            <div class="message-row @(message.SenderId == Session.Id ? "mine" : "")" @key="message.Id"><div class="message-bubble">@message.Text</div><small>@Date(message.SentAt) @(message.SenderId == Session.Id ? "· Sent" : "")</small></div>
                        }
                        @foreach (var item in pending.Values.Where(p => p.Key == Key).ToList())
                        {
                            <div class="message-row mine"><div class="message-bubble">@item.Text</div><small>@(item.Failed ? "Failed to send" : "Sending…")</small>@if (item.Failed) { <button class="text-button" @onclick="() => SendPending(item)">Retry message</button> }</div>
                        }
                    </div>
                    @if (SelectedRequest is { } selectedRequest)
                    {
                        <div class="request-actions">
                            <div class="actions">
                                @if (selectedRequest.Incoming)
                                {
                                    <button disabled="@Busy" @onclick='() => ConnectionAction(selectedRequest, "accept")'>Accept</button>
                                    <button class="secondary" disabled="@Busy" @onclick='() => ConnectionAction(selectedRequest, "decline")'>Decline</button>
                                }
                                else { <button class="secondary" disabled="@Busy" @onclick='() => ConnectionAction(selectedRequest, "cancel")'>Cancel request</button> }
                                <a class="text-button" href="/people/@selectedRequest.Person.Id">View profile</a>
                            </div>
                        </div>
                    }
                    else if (messagePage.CanMessage)
                    {
                        <MessageComposer @key="Key" Sending="@sending" Submitted="SendText" />
                    }
                    else { <div class="notice">This conversation is closed. Existing messages are available to both participants until an account is deleted.</div> }
                }
            </section>
        </div>
}
@code {
    [Parameter] public string? Key { get; set; }
    List<Conversation> conversations = [];
    List<ConnectionItem> connections = [];
    List<Message> history = [];
    MessagePage? messagePage;
    string loadedKey = "", confirmAction = "";
    bool sending, refreshing, refreshAgain, hasOlder, menuOpen;
    readonly CancellationTokenSource stop = new();
    readonly Dictionary<Guid, PendingMessage> pending = new();
    Conversation? Selected => conversations.FirstOrDefault(c => c.Key == Key);
    ConnectionItem? SelectedRequest => connections.FirstOrDefault(c => c.State == "pending" && c.Key == Key);
    Guid? SelectedPersonId => SelectedRequest?.Person.Id ?? Selected?.PersonId;
    List<ConnectionItem> Requests => connections.Where(c => c.State == "pending").OrderByDescending(c => c.Incoming).ThenByDescending(c => c.Updated).ToList();
    IEnumerable<Conversation> Chats => conversations.Where(c => !connections.Any(r => r.State == "pending" && r.Key == c.Key));
    class PendingMessage(Guid id, string text, string key) { public Guid Id = id; public string Text = text; public string Key = key; public bool Failed; }
    protected override async Task OnParametersSetAsync()
    {
        if (Key != loadedKey) { history.Clear(); messagePage = null; hasOlder = false; confirmAction = ""; menuOpen = false; loadedKey = Key ?? ""; }
        if (Session?.Id != null) await Run(Refresh);
    }
    protected override async Task OnAfterRenderAsync(bool first) { await base.OnAfterRenderAsync(first); if (first) _ = Poll(); }
    async Task Poll()
    {
        try { using var timer = new PeriodicTimer(TimeSpan.FromSeconds(20)); while (await timer.WaitForNextTickAsync(stop.Token)) { await InvokeAsync(async () => { await Run(Refresh); await Platform.StartRealtime(); StateHasChanged(); }); } }
        catch (OperationCanceledException) { }
    }
    protected override async Task Refresh()
    {
        if (Session?.Id == null) return;
        if (refreshing) { refreshAgain = true; return; }
        refreshing = true; refreshAgain = false;
        try
        {
            conversations = await Api.Get<List<Conversation>>("conversations");
            connections = await Api.Get<List<ConnectionItem>>("connections");
            if (Key != null)
            {
                var key = Key; MessagePage result;
                if (history.Count == 0)
                {
                    result = await Api.Get<MessagePage>($"conversations/{key}/messages");
                    if (Key != key) return;
                    hasOlder = result.HasOlder; history = result.Items;
                }
                else
                {
                    do
                    {
                        result = await Api.Get<MessagePage>($"conversations/{key}/messages?after={history[^1].Id}");
                        if (Key != key) return;
                        history = history.Concat(result.Items).DistinctBy(m => m.Id).OrderBy(m => m.Id).ToList();
                    } while (result.HasNewer);
                }
                if (Key != key) return;
                messagePage = result;
                foreach (var m in history) pending.Remove(m.ClientId);
                if (history.Count > 0 && Selected?.Unread > 0)
                {
                    await Api.Send<Ok>($"conversations/{key}/read", new ReadInput(history[^1].Id));
                    conversations = await Api.Get<List<Conversation>>("conversations");
                }
            }
        }
        finally { refreshing = false; if (refreshAgain) await Refresh(); }
    }
    Task Older() => Run(async () =>
    {
        var key = Key;
        var older = await Api.Get<MessagePage>($"conversations/{key}/messages?before={history.FirstOrDefault()?.Id ?? long.MaxValue}");
        if (Key != key) return;
        history = older.Items.Concat(history).DistinctBy(m => m.Id).OrderBy(m => m.Id).ToList(); hasOlder = older.HasOlder; messagePage = older;
    });
    async Task SendText(string text)
    {
        if (sending || string.IsNullOrWhiteSpace(text) || Key == null) return;
        var item = new PendingMessage(Guid.NewGuid(), text.Trim(), Key); pending[item.Id] = item; await SendPending(item);
    }
    async Task SendPending(PendingMessage item)
    {
        if (sending) return; item.Failed = false; sending = true;
        try
        {
            var result = await Api.Send<Message>($"conversations/{item.Key}/messages", new MessageInput(item.Id, item.Text)); pending.Remove(item.Id);
            if (item.Key == Key) history = history.Append(result).DistinctBy(m => m.Id).OrderBy(m => m.Id).ToList();
            await Refresh(); Error = "";
        }
        catch (Exception e) { item.Failed = true; Error = e is ApiException ? e.Message : "Message couldn't be sent. Retry when your connection returns."; }
        finally { sending = false; }
    }
    Task ConnectionAction(ConnectionItem item, string action) => Act(async () =>
    {
        await Api.Send<Ok>("connections/" + action, new ConnectionInput(item.Person.Id)); await Refresh();
        if (action == "accept") Nav.NavigateTo("/messages/" + item.Key);
        else if (Key == item.Key) Nav.NavigateTo("/messages");
    });
    void Ask(string action) { menuOpen = false; confirmAction = action; }
    void MenuKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") menuOpen = false; }
    Task ConfirmAction() => Act(async () =>
    {
        if (SelectedPersonId is not { } id) return;
        if (confirmAction == "block") await Api.Send<Ok>($"people/{id}/block");
        else await Api.Send<Ok>("connections/remove", new ConnectionInput(id));
        confirmAction = ""; await Refresh();
    });
    public override void Dispose() { stop.Cancel(); stop.Dispose(); base.Dispose(); }
}
