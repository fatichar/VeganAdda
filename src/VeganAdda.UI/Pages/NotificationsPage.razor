@page "/notifications"
@inherits Screen
<PageTitle>Notifications · VeganAdda</PageTitle>
<div class="narrow">
    <div class="section-heading notification-heading"><h1>Notifications</h1>@if (items?.Unread > 0) { <button class="secondary small-button" disabled="@Busy" @onclick="MarkRead">Mark all read</button> }</div>
    <Feedback Error="@Error" />
    @if (Session?.Id == null)
    {
        <Empty Icon="notifications" Title="Your notifications" Text="Sign in to see connection requests and updates."><a href="/signin?returnUrl=%2Fnotifications" class="button">Sign in</a></Empty>
    }
    else if (items?.Items.Count == 0)
    {
        <Empty Icon="notifications_none" Title="No notifications" Text="Connection requests and updates will appear here." />
    }
    else if (items != null)
    {
        <div class="notification-toolbar">
            <label class="notification-select"><input type="checkbox" aria-label="Select shown notifications" checked="@(items.Items.Count > 0 && items.Items.All(n => selected.Contains(n.Id)))" @onchange="SelectShown" disabled="@Busy" />Select shown</label>
            @if (selected.Count > 0) { <button class="text-button danger" disabled="@Busy" @onclick="DeleteSelected">Delete selected (@selected.Count)</button> }
            <button class="text-button danger" disabled="@Busy" @onclick="() => confirmAll = true">Delete all</button>
        </div>
        @if (confirmAll)
        {
            <div class="notice" role="alert"><p>Delete all notifications, including older ones?</p><button class="danger-button" disabled="@Busy" @onclick="DeleteAll">Delete all notifications</button><button class="text-button" @onclick="() => confirmAll = false">Cancel</button></div>
        }
        <div class="notification-list">
            @foreach (var n in items.Items)
            {
                <article class="notification card @(n.Read ? "" : "unread")" @key="n.Id">
                    <label class="notification-select"><input type="checkbox" aria-label="@($"Select notification: {n.Text}")" checked="@selected.Contains(n.Id)" @onchange="e => Select(n.Id, e)" disabled="@Busy" /></label>
                    <a class="notification-content" href="@n.Url" @onclick="() => Open(n)" @onclick:preventDefault>
                        <span class="notice-symbol"><Icon Name="@(n.Kind == "admin-appointed" ? "admin_panel_settings" : n.Kind == "admin-revoked" ? "person_off" : n.Kind == "declined" ? "person_remove" : "person_add")" /></span><div><strong>@n.Text</strong><small>@Date(n.Created)</small></div><Icon Name="arrow_forward" />
                    </a>
                    <button class="icon-button danger" aria-label="@($"Delete notification: {n.Text}")" disabled="@Busy" @onclick="() => Delete([n.Id])"><Icon Name="delete" /></button>
                </article>
            }
        </div>
        <Pagination PageNumber="@(page)" PageSize="@items.PageSize" Total="@items.Total" Busy="@Busy" PageChanged="SetPage" />
    }
</div>
@code {
    protected override ChangeArea ChangeInterests => ChangeArea.Notifications | ChangeArea.Connections | ChangeArea.Profiles;
    NotificationList? items;
    readonly HashSet<Guid> selected = [];
    bool confirmAll; int page = 1;
    protected override async Task OnInitializedAsync() { await base.OnInitializedAsync(); if (Session?.Id != null) await Run(Refresh); }
    protected override async Task Refresh()
    {
        if (Session?.Id == null) return;
        items = await Api.Get<NotificationList>($"notifications?page={page}");
        page = items.PageNumber;
        if (items.Items.Count == 0) confirmAll = false;
    }
    Task MarkRead() => Run(async () => { await Api.Send<Ok>("notifications/read"); await Refresh(); });
    Task SetPage(int value) { page = value; return Run(Refresh); }
    async Task Open(Notice notice)
    {
        if (Busy) return;
        await Run(async () =>
        {
            await Api.Send<Ok>($"notifications/{notice.Id}/read");
            Nav.NavigateTo(notice.Url);
        });
    }
    void Select(Guid id, ChangeEventArgs e) { if (e.Value is true) selected.Add(id); else selected.Remove(id); }
    void SelectShown(ChangeEventArgs e) { if (items == null) return; if (e.Value is true) selected.UnionWith(items.Items.Select(n => n.Id)); else selected.ExceptWith(items.Items.Select(n => n.Id)); }
    Task DeleteSelected() => Delete(selected.ToArray());
    Task DeleteAll() => Delete([], true);
    async Task Delete(Guid[] ids, bool all = false)
    {
        if (Busy) return;
        await Run(async () =>
        {
            await Api.Send<Ok>("notifications", new NotificationSelection(ids, all), "DELETE");
            if (all) selected.Clear(); else selected.ExceptWith(ids);
            confirmAll = false; await Refresh();
        });
    }
}
