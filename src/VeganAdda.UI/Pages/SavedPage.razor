@page "/saved"
@inherits Screen
<PageTitle>Saved · VeganAdda</PageTitle>
<h1>Saved</h1><Feedback Error="@Error" Success="@Success" />
@if (Session?.Id == null) { <Empty Icon="bookmark_border" Title="Your saved items" Text="Sign in to privately save people and events."><a class="button" href="/signin?returnUrl=%2Fsaved">Sign in</a></Empty> }
else if (items != null) { <div class="tab-row"><button class="chip @(peopleTab ? "active" : "")" aria-pressed="@(peopleTab ? "true" : "false")" @onclick="() => SwitchTab(true)">People · @items.People.Count</button><button class="chip @(!peopleTab ? "active" : "")" aria-pressed="@(!peopleTab ? "true" : "false")" @onclick="() => SwitchTab(false)">Events · @items.Events.Count</button></div>@if (peopleTab) { @if (items.People.Count == 0) { <Empty Title="No saved people yet" Text="Tap the bookmark on a profile to find it here later."><a class="button secondary" href="/">Discover people</a></Empty> }<div class="people-grid">@foreach (var p in items.People.Skip((peoplePage - 1) * 12).Take(12)) { <PersonCard Person="p" Viewer="Session.Id" Save="SavePerson" Connect="Connect" /> }</div><Pagination PageNumber="@peoplePage" Total="@items.People.Count" Busy="@Busy" PageChanged="SetPage" /> } else { @if (items.Events.Count == 0) { <Empty Icon="festival" Title="No saved events yet" Text="Save an event and you'll find it here."><a class="button secondary" href="/events">Explore events</a></Empty> }<div class="events-grid">@foreach (var ev in items.Events.Skip((eventsPage - 1) * 12).Take(12)) { <EventCardView Event="ev" Save="SaveEvent" /> }</div><Pagination PageNumber="@eventsPage" Total="@items.Events.Count" Busy="@Busy" PageChanged="SetPage" /> } }
<ConnectDialog Person="connecting" Closed="() => connecting = null" Sent="Refresh" />
@code {
    SavedItems? items; bool peopleTab = true; int peoplePage = 1, eventsPage = 1; Person? connecting;
    protected override async Task OnInitializedAsync() { await base.OnInitializedAsync(); if (Session?.Id != null) await Run(Refresh); }
    protected override async Task Refresh() { items = await Api.Get<SavedItems>("saved"); peoplePage = Math.Min(peoplePage, Math.Max(1, (items.People.Count + 11) / 12)); eventsPage = Math.Min(eventsPage, Math.Max(1, (items.Events.Count + 11) / 12)); }
    Task SwitchTab(bool people) { peopleTab = people; return Task.CompletedTask; }
    Task SetPage(int value) { if (peopleTab) peoplePage = value; else eventsPage = value; return Task.CompletedTask; }
    Task SavePerson(Person p) => Act(async () => { await Api.Send<Ok>($"people/{p.Id}/save"); await Refresh(); });
    Task SaveEvent(EventCard e) => Act(async () => { await Api.Send<Ok>($"events/{e.Id}/save"); await Refresh(); });
    Task Connect(Person p) { connecting = p; return Task.CompletedTask; }
}

