@page "/saved"
@inherits Screen
<PageTitle>Saved · VeganAdda</PageTitle>
<h1>Saved</h1><Feedback Error="@Error" Success="@Success" />
@if (Session?.Id == null) { <Empty Icon="bookmark_border" Title="Your saved items" Text="Sign in to privately save people and events."><a class="button" href="/signin?returnUrl=%2Fsaved">Sign in</a></Empty> }
else if (items != null) { <div class="tab-row"><button class="chip @(peopleTab ? "active" : "")" aria-pressed="@(peopleTab ? "true" : "false")" @onclick="() => peopleTab = true">People · @items.People.Count</button><button class="chip @(!peopleTab ? "active" : "")" aria-pressed="@(!peopleTab ? "true" : "false")" @onclick="() => peopleTab = false">Events · @items.Events.Count</button></div>@if (peopleTab) { @if (items.People.Count == 0) { <Empty Title="No saved people yet" Text="Tap the bookmark on a profile to find it here later."><a class="button secondary" href="/">Discover people</a></Empty> }<div class="people-grid">@foreach (var p in items.People) { <PersonCard Person="p" Viewer="Session.Id" Save="SavePerson" Connect="Connect" /> }</div> } else { @if (items.Events.Count == 0) { <Empty Icon="festival" Title="No saved events yet" Text="Save an event and you'll find it here."><a class="button secondary" href="/events">Explore events</a></Empty> }<div class="events-grid">@foreach (var ev in items.Events) { <EventCardView Event="ev" Save="SaveEvent" /> }</div> } }
<ConnectDialog Person="connecting" Closed="() => connecting = null" Sent="Refresh" />
@code {
    SavedItems? items; bool peopleTab = true; Person? connecting;
    protected override async Task OnInitializedAsync() { await base.OnInitializedAsync(); if (Session?.Id != null) await Run(Refresh); }
    protected override async Task Refresh() => items = await Api.Get<SavedItems>("saved");
    Task SavePerson(Person p) => Act(async () => { await Api.Send<Ok>($"people/{p.Id}/save"); await Refresh(); });
    Task SaveEvent(EventCard e) => Act(async () => { await Api.Send<Ok>($"events/{e.Id}/save"); await Refresh(); });
    Task Connect(Person p) { connecting = p; return Task.CompletedTask; }
}

