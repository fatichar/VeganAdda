@using Microsoft.JSInterop
@inject IJSRuntime JS
@inherits Screen
<details class="member-report">
    <summary>Report this member</summary>
    <Feedback Error="@Error" Success="@Success" />
    <fieldset class="report-fields" disabled="@(Busy || !RendererInfo.IsInteractive)">
    <label for="report-reason">Reason</label>
    <select id="report-reason" @bind="reason">
        <option value="">Choose a reason</option>
        @foreach (var option in ReportReasons.All) { <option>@option</option> }
    </select>
    <label for="report-details">Details (optional)</label>
    <textarea id="report-details" maxlength="1000" rows="3" @bind="details" @bind:event="oninput" placeholder="Tell the community team what happened…"></textarea>
    <label for="report-screenshot">Screenshot (optional)</label>
    <InputFile id="report-screenshot" @key="uploadKey" OnChange="Upload" accept="image/jpeg,image/png,image/webp" disabled="@(Busy || !RendererInfo.IsInteractive)" />
    <small>JPG, PNG or WebP · up to 10 MB. Report details and screenshots are visible only to administrators.</small>
    @if (screenshot != null) { <p class="small">Screenshot attached. <button type="button" class="text-button" @onclick="RemoveScreenshot">Remove</button></p> }
    <button type="button" class="secondary" @onclick="Submit" disabled="@(Busy || reason == "" || !RendererInfo.IsInteractive)">Submit report</button>
    </fieldset>
</details>
@code {
    [Parameter] public Guid PersonId { get; set; }
    string reason = "", details = "";
    string? screenshot;
    int uploadKey;
    void RemoveScreenshot() { screenshot = null; uploadKey++; }
    Task Upload(InputFileChangeEventArgs e) => Act(async () =>
    {
        var file = e.File;
        if (file.Size > 10 * 1024 * 1024) { Error = "Please choose an image smaller than 10 MB."; return; }
        var (stream, name, contentType) = await ImageResizer.ProcessUpload(JS, e, "report-screenshot");
        await using (stream)
        {
            screenshot = await Platform.Upload(stream, name, contentType, reportScreenshot: true);
        }
    });
    Task Submit() => Act(async () =>
    {
        await Api.Send<Ok>($"people/{PersonId}/report", new ReportInput(PersonId, reason, details, screenshot));
        reason = ""; details = ""; RemoveScreenshot();
        Success = "Thank you. The community team will review your report.";
    });
}
