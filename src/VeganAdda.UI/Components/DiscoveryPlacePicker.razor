@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable
<div class="discovery-place-fields">
    <label for="discover-country">Country <span class="muted">(optional)</span></label>
    <input id="discover-country" list="discover-countries" maxlength="80" placeholder="Any country" @bind="Country" @bind:after="CountryChanged" disabled="@loading" />
    <datalist id="discover-countries">@foreach (var country in countries) { <option value="@country.Name"></option> }</datalist>
    <label for="discover-state">State / region <span class="muted">(optional)</span></label>
    <input id="discover-state" list="discover-states" maxlength="80" placeholder="Any state / region" @bind="State" @bind:after="StateChanged" disabled="@loading" />
    <datalist id="discover-states">@foreach (var state in states) { <option value="@state.Name"></option> }</datalist>
    <label for="discover-city">City <span class="muted">(optional)</span></label>
    <input id="discover-city" list="discover-cities" maxlength="80" placeholder="Any city" @bind="City" />
    <datalist id="discover-cities">@foreach (var city in Cities) { <option value="@city"></option> }</datalist>
    @if (error != "") { <p class="small" role="status">@error</p> }
    <small>Leave fields empty to widen your search. You can type a place if it isn't listed.</small>
    <div class="discovery-panel-actions"><button type="button" class="text-button" @onclick="Clear">Anywhere</button><button type="button" @onclick="Apply" disabled="@loading">Show people</button></div>
</div>
@code {
    [Parameter] public string Country { get; set; } = "";
    [Parameter] public string State { get; set; } = "";
    [Parameter] public string City { get; set; } = "";
    [Parameter] public EventCallback<DiscoveryInput> Selected { get; set; }
    IJSObjectReference? data;
    LocationPicker.CountryOption[] countries = [];
    LocationPicker.StateOption[] states = [];
    IEnumerable<string> Cities => states.FirstOrDefault(s => s.Name == State)?.Cities ?? [];
    bool loading = true; string error = "";
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            data = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/VeganAdda.UI/location-data.js");
            countries = await data.InvokeAsync<LocationPicker.CountryOption[]>("countries");
            await LoadStates();
        }
        catch (JSException) { error = "Suggestions couldn't load. You can still type your location."; }
        finally { loading = false; StateHasChanged(); }
    }
    async Task LoadStates()
    {
        states = []; var country = countries.FirstOrDefault(c => c.Name.Equals(Country, StringComparison.OrdinalIgnoreCase));
        if (country != null && data != null) { Country = country.Name; states = await data.InvokeAsync<LocationPicker.StateOption[]>("states", country.Code); }
    }
    async Task CountryChanged()
    {
        State = City = error = ""; loading = true;
        try { await LoadStates(); }
        catch (JSException) { error = "Suggestions couldn't load. You can still type your location."; }
        finally { loading = false; }
    }
    void StateChanged() { City = ""; State = states.FirstOrDefault(s => s.Name.Equals(State, StringComparison.OrdinalIgnoreCase))?.Name ?? State; }
    Task Apply() => Selected.InvokeAsync(new() { Country = Country.Trim(), State = State.Trim(), City = City.Trim() });
    Task Clear() { Country = State = City = ""; return Apply(); }
    public async ValueTask DisposeAsync() { try { if (data != null) await data.DisposeAsync(); } catch (JSDisconnectedException) { } }
}
