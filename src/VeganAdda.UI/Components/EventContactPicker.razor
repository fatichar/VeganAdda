@implements IDisposable
@inject IEventsApi EventsApi

<section class="event-contact-picker" aria-labelledby="event-contacts-heading">
    <h3 id="event-contacts-heading">Contact Person(s)</h3>
    <div class="event-contact-row">
        <Icon Name="person" />
        <strong>@(DefaultContact?.Name ?? "Event poster unavailable")@if (DefaultContact?.Id == Poster.Id) { <span class="muted"> (you)</span> }</strong>
        <span class="badge">Default contact</span>
    </div>
    @foreach (var contact in Model.Contacts ?? [])
    {
        <div class="event-contact-row" @key="contact.Id">
            <Icon Name="person" />
            <strong>@contact.Name</strong>
            <button type="button" class="text-button" aria-label="@($"Remove {contact.Name}")"
                    @onclick="() => Remove(contact)">Remove</button>
        </div>
    }
    <p class="small muted">Phone numbers are available on members’ profiles when they choose to share them.</p>

    @if (editing)
    {
        var candidates = results.Where(c => c.Id != DefaultContact?.Id && !(Model.Contacts ?? []).Any(p => p.Id == c.Id)).ToArray();
        <div id="event-contact-lookup">
            <label for="event-contact-search">Search VeganAdda members</label>
            <input id="event-contact-search" type="search" form="event-contact-search-form" autocomplete="off"
                   maxlength="80" placeholder="Search by name" value="@query" @ref="searchInput" @oninput="Search" />
            @if (candidates.Length > 0)
            {
                <ul aria-label="Matching members">
                    @foreach (var candidate in candidates)
                    {
                        <li @key="candidate.Id"><button type="button" class="secondary small-button"
                            @onclick="() => Choose(candidate)">@candidate.Name</button></li>
                    }
                </ul>
            }
            @if (searching) { <small role="status">Searching…</small> }
            else if (error) { <small class="error-text" role="status">Member search is unavailable. Try again.</small> }
            else if (query.Trim().Length >= 2 && candidates.Length == 0) { <small role="status">No matching members.</small> }
            <button type="button" class="text-button" @onclick="Close">Done</button>
        </div>
    }
    else
    {
        <button type="button" class="secondary small-button" @onclick="Open"><Icon Name="add" />Add another contact</button>
    }
    <span class="sr-only" aria-live="polite">@selectionStatus</span>
</section>

@code {
    [Parameter, EditorRequired] public EventInput Model { get; set; } = default!;
    [Parameter, EditorRequired] public EventContact Poster { get; set; } = default!;

    EventContact? DefaultContact => Model.Id == Guid.Empty ? Poster : Model.Creator;
    List<EventContact> results = [];
    string query = "", selectionStatus = "";
    bool editing, searching, error, focusSearch;
    ElementReference searchInput;
    CancellationTokenSource? searchCancellation;

    void Open()
    {
        editing = true;
        focusSearch = true;
    }

    void Close()
    {
        editing = false;
        query = "";
        ResetSearch();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusSearch) return;
        focusSearch = false;
        await searchInput.FocusAsync();
    }

    async Task Search(ChangeEventArgs args)
    {
        query = args.Value?.ToString() ?? "";
        var term = query.Trim();
        ResetSearch();
        if (term.Length is < 2 or > 80) return;

        searchCancellation = new();
        var token = searchCancellation.Token;
        searching = true;
        try
        {
            await Task.Delay(300, token);
            var matches = await EventsApi.SearchEventContacts(term);
            if (!token.IsCancellationRequested) results = matches;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            if (!token.IsCancellationRequested) error = true;
        }
        finally
        {
            if (!token.IsCancellationRequested) searching = false;
        }
    }

    void Choose(EventContact contact)
    {
        Model.Contacts = [.. Model.Contacts ?? [], contact];
        query = "";
        selectionStatus = $"{contact.Name} added.";
        ResetSearch();
        focusSearch = true;
    }

    void Remove(EventContact contact)
    {
        Model.Contacts = (Model.Contacts ?? []).Where(c => c.Id != contact.Id).ToArray();
        selectionStatus = $"{contact.Name} removed.";
    }

    void ResetSearch()
    {
        searchCancellation?.Cancel();
        searchCancellation?.Dispose();
        searchCancellation = null;
        results = [];
        searching = error = false;
    }

    public void Dispose() => ResetSearch();
}
