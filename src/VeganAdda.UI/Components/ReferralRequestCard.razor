@inherits Screen
@inject IVerificationApi VerificationApi
@foreach (var card in cards.Where(card => card.Status == VerificationState.UnderReview && (ActionableOnly ? card.CanRespond : true)))
{
    <section class="notice referral-request @(ActionableOnly ? "referral-request-pinned" : "")" id="vegan-confirmation" aria-label="Vegan confirmation request">
        <strong>Vegan confirmation request</strong>
        <p>@(card.ApplicantId == Session?.Id ? "You asked this member to confirm you are vegan." : $"{card.ApplicantName} asked you to confirm they are vegan.")</p>
        @if (!ActionableOnly) { <p class="small" role="status">@card.Status.Label() · @card.ReferralStatus.Label()</p> }
        @if (card.CanRespond)
        {
            <p class="small">Confirm only if you know this person is vegan. A moderator makes the final verification decision.</p>
            <div class="actions"><button type="button" disabled="@(Busy || !RendererInfo.IsInteractive)" @onclick="() => Respond(card.Id, true)">I confirm this person is vegan</button><button type="button" class="secondary" disabled="@(Busy || !RendererInfo.IsInteractive)" @onclick="() => Respond(card.Id, false)">Decline</button></div>
        }
        <Feedback Error="@Error" Success="@Success" />
    </section>
}
@code {
    [Parameter] public Guid PersonId { get; set; }
    [Parameter] public bool ActionableOnly { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    List<ReferralCard> cards = [];
    protected override async Task OnInitializedAsync() { await base.OnInitializedAsync(); }
    protected override Task OnParametersSetAsync() => Run(Refresh);
    protected override async Task Refresh() { if (Session?.Id != null) cards = await VerificationApi.GetReferralCards(PersonId); }
    Task Respond(Guid id, bool confirm) => Act(async () =>
    {
        try { await VerificationApi.RespondToReferral(id, confirm); Success = confirm ? "Confirmation sent for moderator review." : "Request declined."; }
        finally { await Refresh(); await Changed.InvokeAsync(); }
    });
}
